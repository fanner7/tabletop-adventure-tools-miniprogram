<!-- pages/cairn-gen/cairn-gen.wxml — 石冢 Cairn 冒险者工具 -->
<view class="cairn-container theme-{{theme}}">

  <!-- ===== STEP 0: 角色列表 ===== -->
  <block wx:if="{{step === 0}}">
    <view class="header">
      <text class="header-title">⛰️ 石冢 冒险者工具</text>
      <text class="header-subtitle">Cairn TTRPG — Adventurer Kit</text>
    </view>
    <button class="btn btn-primary" bindtap="showKitPicker">➕ 创建新角色</button>
    <button class="btn-import" bindtap="importCharacter">📥 从剪贴板导入角色</button>
    <view class="char-list" wx:if="{{characters.length > 0}}">
      <text class="section-title">📂 已保存的角色</text>
      <view class="char-item" wx:for="{{characters}}" wx:for-item="ch" wx:key="id" bindtap="openChar" data-index="{{index}}">
        <view class="char-item-info">
          <text class="char-item-name">{{ch.name}}</text>
          <text class="char-item-meta">{{ch.background}} · HP {{ch.hp}}/{{ch.hpMax||ch.hp}}</text>
        </view>
        <text class="char-item-del" catchtap="deleteChar" data-index="{{index}}">✕</text>
      </view>
    </view>
    <view class="empty-hint" wx:if="{{characters.length === 0}}">
      <text>暂无角色，点击上方按钮创建</text>
    </view>

    <!-- ===== 创建方式选择弹窗 ===== -->
    <view class="dialog-overlay {{showKitPicker ? 'active' : ''}}" bindtap="closeKitPicker" catchtouchmove="preventTouchMove"></view>
    <view class="dialog-sheet kit-dialog {{showKitPicker ? 'active' : ''}}">
      <view class="dialog-handle"></view>
      <text class="dialog-title">{{kitStep === 'list' ? '🎒 选择职业套装' : '🎲 创建方式'}}</text>
      <block wx:if="{{kitStep === 'pick'}}">
        <view class="kit-option" bindtap="pickRandom">
          <view class="kit-option-main">
            <text class="kit-option-emoji">🎲</text>
            <view class="kit-option-text">
              <text class="kit-name">全随机生成 <text class="kit-tag">推荐</text></text>
              <text class="kit-desc">属性与装备全部从随机表生成</text>
            </view>
          </view>
          <text class="kit-arrow">›</text>
        </view>
        <view class="kit-option" bindtap="pickKitList">
          <view class="kit-option-main">
            <text class="kit-option-emoji">🎒</text>
            <view class="kit-option-text">
              <text class="kit-name">自选职业套装</text>
              <text class="kit-desc">从 10 个职业套装中选择，生成对应专属装备</text>
            </view>
          </view>
          <text class="kit-arrow">›</text>
        </view>
      </block>
      <block wx:else>
        <scroll-view class="kit-list" scroll-y show-scrollbar="{{false}}">
          <view class="kit-grid">
          <view class="kit-card" wx:for="{{kits}}" wx:for-item="k" wx:key="n" bindtap="pickGenerateMode" data-kit="{{index}}">
            <text class="kit-emoji">{{k.e}}</text>
            <text class="kit-card-name">{{k.n}}</text>
            <text class="kit-card-items">{{k.items0}}</text>
          </view>
          </view>
        </scroll-view>
        <view class="dialog-actions">
          <button class="dialog-btn cancel" bindtap="backKitList">← 返回</button>
        </view>
      </block>
      <view class="dialog-actions" wx:if="{{kitStep === 'pick'}}">
        <button class="dialog-btn cancel" bindtap="closeKitPicker">取消</button>
      </view>
    </view>
    <view class="cairn-attribution">
      <text>Cairn RPG © Yochai Gal · 中文翻译 ZzNoah · CC-BY-SA 4.0</text>
    </view>
  </block>

  <!-- ===== STEP 1: 角色卡 ===== -->
  <block wx:if="{{step === 1 && char}}">
    <view class="play-header">
      <text class="back-btn" bindtap="backToList">← 返回</text>
      <text class="play-name">{{char.name}}</text>
    </view>

    <!-- 属性卡片 -->
    <view class="card attr-card">
      <view class="attr-mini str" bindtap="doCheck" data-attr="str">
        <text class="am-val">{{char.str}}<text class="am-max">/{{char.strMax}}</text></text>
        <text class="am-label">力量 STR</text>
        <view class="am-btns">
          <text class="am-pm" catchtap="statDelta" data-field="str" data-delta="-1">−</text>
          <text class="am-pm" catchtap="statDelta" data-field="str" data-delta="1">+</text>
        </view>
      </view>
      <view class="attr-mini dex" bindtap="doCheck" data-attr="dex">
        <text class="am-val">{{char.dex}}<text class="am-max">/{{char.dexMax}}</text></text>
        <text class="am-label">敏捷 DEX</text>
        <view class="am-btns">
          <text class="am-pm" catchtap="statDelta" data-field="dex" data-delta="-1">−</text>
          <text class="am-pm" catchtap="statDelta" data-field="dex" data-delta="1">+</text>
        </view>
      </view>
      <view class="attr-mini wil" bindtap="doCheck" data-attr="wil">
        <text class="am-val">{{char.wil}}<text class="am-max">/{{char.wilMax}}</text></text>
        <text class="am-label">意志 WIL</text>
        <view class="am-btns">
          <text class="am-pm" catchtap="statDelta" data-field="wil" data-delta="-1">−</text>
          <text class="am-pm" catchtap="statDelta" data-field="wil" data-delta="1">+</text>
        </view>
      </view>
    </view>

    <!-- HP 护甲 金币 -->
    <view class="card hp-card-row">
      <view class="hp-block">
        <text class="hpl">耐久 HP</text>
        <text class="hpv">{{char.hp}} / {{char.hpMax}}</text>
        <view class="am-btns">
          <text class="am-pm" bindtap="statDelta" data-field="hp" data-delta="-1">−</text>
          <text class="am-pm" bindtap="statDelta" data-field="hp" data-delta="1">+</text>
        </view>
      </view>
      <view class="ag-block">
        <view class="ag-item">
          <text class="agl">护甲</text>
          <input class="ag-inp" type="number" value="{{char.armor}}" bindinput="onArmorInput" max="3" />
          <text class="agl">/3</text>
        </view>
        <view class="ag-item coins-row">
          <text class="coin-label">GP</text>
          <input class="coin-inp" type="number" value="{{char.gp}}" bindinput="onCoinInput" data-field="gp" />
          <text class="coin-label">SP</text>
          <input class="coin-inp" type="number" value="{{char.sp}}" bindinput="onCoinInput" data-field="sp" />
          <text class="coin-label">CP</text>
          <input class="coin-inp" type="number" value="{{char.cp}}" bindinput="onCoinInput" data-field="cp" />
        </view>
      </view>
    </view>

    <!-- 背包卡片 -->
    <view class="card">
      <view class="inv-head">
        <text class="card-title">背包 {{invUsed}}/{{char.invSlots}}</text>
      </view>
      <view class="inv-slot {{dragFrom === i ? 'dragging' : ''}}" style="{{invRowStyles[i]}}" wx:for="{{char.inventory}}" wx:for-index="i" wx:key="id">
        <view class="inv-drag {{item.v && item.v.trim() ? '' : 'empty'}}" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd" catchtouchcancel="onDragEnd" data-index="{{i}}"><text>≡</text></view>
        <text class="inv-idx">{{i+1}}</text>
        <input class="inv-input" value="{{item.v}}" bindinput="onInvInput" data-index="{{i}}" placeholder="空" />
        <text class="inv-del" catchtap="deleteInvItem" data-index="{{i}}">✕</text>
      </view>
      <view class="inv-actions">
        <view class="btn-fatigue-lg" bindtap="addFatigue">+ 疲乏词条</view>
        <view class="btn-fatigue-lg" bindtap="addBulk">+ 笨重词条</view>
      </view>
    </view>

    <!-- 掷骰卡片 -->
    <view class="card">
      <text class="card-title">掷骰</text>
      <view class="dice-rolling-hint" wx:if="{{diceRolling}}"><text>投掷中…</text></view>
      <view class="dice-result-highlight" wx:if="{{diceResult}}">
        <text class="drh-total">{{diceResult.total}}</text>
        <view class="drh-dice">
          <text class="drh-chip" wx:for="{{diceResult.dice}}" wx:for-item="r" wx:key="index">d{{r.sides}} → {{r.result}}</text>
        </view>
      </view>
      <view class="dice-row">
        <view class="dice-btn-wrap" wx:for="{{[4,6,8,10,12,20,100]}}" wx:for-item="d" wx:key="d">
          <text class="dice-btn {{diceSelected[d] ? 'sel' : ''}}" bindtap="selectDice" bindlongpress="deselectDice" data-d="{{d}}">d{{d}}</text>
          <text class="dice-badge" wx:if="{{diceSelected[d]}}">{{diceSelected[d]}}</text>
        </view>
      </view>
      <view class="dice-actions">
        <button class="btn-roll {{diceRolling ? 'rolling' : ''}}" bindtap="rollSelected" disabled="{{diceRolling}}">{{diceRolling ? '...' : '投掷'}}</button>
        <button class="btn-clear" bindtap="clearDice">清除</button>
      </view>
      <view class="dice-log" wx:if="{{diceHistory.length > 0}}">
        <view class="dl-head">
          <text class="dl-title">历史</text>
          <text class="dl-clear" bindtap="clearHistory">清空</text>
        </view>
        <text class="dl-item" wx:for="{{diceHistory}}" wx:for-item="h" wx:key="index">{{h.total}} <text class="dl-detail" wx:for="{{h.dice}}" wx:for-item="r" wx:key="idx">d{{r.sides}}({{r.result}}) </text><text class="dl-time">{{h.time}}</text></text>
      </view>
    </view>

    <!-- 冒险家信息卡片 -->
    <view class="card">
      <view class="profile-head">
        <text class="card-title" style="margin-bottom:0;">⛰️ 冒险家信息</text>
        <view class="profile-actions">
          <text class="profile-edit" bindtap="copyProfile">📋 复制</text>
          <text class="profile-edit" bindtap="openProfileEdit">✎ 编辑</text>
        </view>
      </view>
      <view class="detail-row"><text class="dlbl">出身</text><text class="dval">{{char.profile.background || '—'}}</text></view>
      <view class="detail-row"><text class="dlbl">年龄</text><text class="dval">{{char.profile.age || '—'}}</text></view>
      <view class="detail-row" wx:if="{{char.profile.desc}}">
        <text class="dlbl">特质</text>
        <text class="dval">{{char.profile.desc}}</text>
      </view>
      <view class="wound-records" wx:if="{{char.wounds.length > 0}}">
        <view class="wound-record" wx:for="{{char.wounds}}" wx:for-item="w" wx:key="index">
          <view class="wound-record-main">
            <text class="wound-record-t">🩹 {{w.t}} <text class="wound-record-ts">{{w.ts}}</text></text>
            <text class="wound-record-d">{{w.d}}</text>
          </view>
          <text class="wound-record-del" catchtap="openWoundEdit" data-index="{{index}}">✎</text>
        </view>
      </view>
    </view>

    <!-- 笔记卡片 -->
    <view class="card">
      <view class="notes-head">
        <text class="card-title" style="margin-bottom:0;">笔记</text>
        <text class="notes-toggle" bindtap="toggleNotes" wx:if="{{notesExpandable}}">{{notesExpanded ? '收起' : '展开'}}</text>
      </view>
      <textarea class="notes-area {{notesExpanded ? 'expanded' : ''}}" value="{{char.notes}}" bindinput="onNotesInput" placeholder="记录线索、故事…" maxlength="-1" />
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-btns">
      <button class="btn btn-primary" style="flex:1;margin:0;" bindtap="saveChar">保存角色</button>
      <button class="btn-subtle" style="flex:1;margin:0;" bindtap="toggleExportDialog">导出</button>
      <button class="btn-subtle" style="flex:1;margin:0;" bindtap="openSpells">法术</button>
    </view>
    <!-- 页面最底部：低频参考工具 -->
    <view class="bottom-tools">
      <view class="btn-subtle" style="flex:1;margin:0;" bindtap="openWounds">🩹 伤痕表</view>
      <view class="btn-subtle" style="flex:1;margin:0;" bindtap="openShop">🛒 商店参考</view>
    </view>
  </block>

  <!-- ===== 检定弹窗 ===== -->
  <view class="dialog-overlay {{showCheck ? 'active' : ''}}" bindtap="closeCheck"></view>
  <view class="check-popup {{showCheck ? 'active' : ''}}">
    <text class="check-title">{{checkLabel}} 检定</text>
    <text class="check-target">目标 ≤ {{checkTarget}}</text>
    <text class="check-roll">🎲 {{checkRoll}}</text>
    <text class="check-result {{checkSuccess ? 'success' : 'fail'}}">{{checkSuccess ? '✅ 成功' : '❌ 失败'}}</text>
    <button class="btn btn-primary" bindtap="closeCheck">确定</button>
  </view>

  <!-- ===== 导出弹窗 ===== -->
  <view class="dialog-overlay {{showExportDialog ? 'active' : ''}}" bindtap="toggleExportDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showExportDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">导出角色</text>
    <view class="export-options">
      <view class="export-option" bindtap="doExportClipboard">
        <view class="export-option-text">
          <text class="export-option-title">导出到剪贴板</text>
          <text class="export-option-desc">复制完整角色数据（JSON），可通过「导入」按钮恢复</text>
        </view>
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="toggleExportDialog">取消</button>
    </view>
  </view>

  <!-- ===== 法术列表弹窗 ===== -->
  <view class="dialog-overlay {{showSpells ? 'active' : ''}}" bindtap="closeSpells" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet spell-dialog {{showSpells ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">100道法术</text>
    <view class="spell-search-bar">
      <input class="spell-search-input" placeholder="搜索法术（支持拼音首字母简写）…" value="{{spellSearch}}" bindinput="onSpellSearch" />
    </view>
    <scroll-view class="spell-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="spell-list-inner">
      <view class="spell-item" wx:for="{{spellList}}" wx:for-item="s" wx:key="name">
        <text class="spell-num">{{s.seq}}</text>
        <view class="spell-info">
          <text class="spell-name">{{s.name}}</text>
          <text class="spell-desc">{{s.desc}}</text>
        </view>
        <text class="spell-add" catchtap="appendSpell" data-name="{{s.name}}">+</text>
      </view>
      </view>
    </scroll-view>
    <view class="dialog-actions">
      <button class="dialog-btn confirm" bindtap="closeSpells">关闭</button>
    </view>
  </view>

  <!-- ===== 商店弹窗 ===== -->
  <view class="dialog-overlay {{showShop ? 'active' : ''}}" bindtap="closeShop" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet shop-dialog {{showShop ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🛒 商店</text>
    <view class="shop-gold">💰 {{char.gp}}gp {{char.sp}}sp {{char.cp}}cp · 背包 {{invUsed}}/{{char.invSlots}}</view>
    <view class="shop-tabs">
      <view class="shop-tab {{shopCat === 'armor' ? 'on' : ''}}" bindtap="switchShopCat" data-cat="armor"><text>护甲</text></view>
      <view class="shop-tab {{shopCat === 'weapon' ? 'on' : ''}}" bindtap="switchShopCat" data-cat="weapon"><text>武器</text></view>
      <view class="shop-tab {{shopCat === 'gear' ? 'on' : ''}}" bindtap="switchShopCat" data-cat="gear"><text>用品 & 工具</text></view>
    </view>
    <scroll-view class="shop-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="shop-list-inner">
      <view class="shop-item" wx:for="{{shopList}}" wx:for-item="it" wx:key="n">
        <view class="shop-info">
          <text class="shop-name">{{it.n}}</text>
          <text class="shop-meta">{{it.s > 1 ? '占 ' + it.s + ' 槽（笨重）' : '占 1 槽'}}{{it.bonus ? ' · 行装上限 +' + it.bonus : ''}}</text>
        </view>
        <text class="shop-price">{{it.p}} gp</text>
        <view class="shop-buy" catchtap="buyItem" data-index="{{index}}"><text>购买</text></view>
      </view>
      </view>
    </scroll-view>
    <view class="dialog-actions">
      <button class="dialog-btn confirm" bindtap="closeShop">关闭</button>
    </view>
  </view>

  <!-- ===== 伤痕表弹窗 ===== -->
  <view class="dialog-overlay {{showWounds ? 'active' : ''}}" bindtap="closeWounds" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showWounds ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🩹 伤痕表</text>
    <view class="wound-body" wx:if="{{woundItem}}">
      <text class="wound-roll">🎲 {{woundRoll}} · {{woundItem.t}}</text>
      <text class="wound-desc">{{woundItem.desc}}</text>
      <text class="wound-extra" wx:if="{{woundExtra}}">{{woundExtra}}</text>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="rollWound">🔄 重投</button>
      <button class="dialog-btn confirm" wx:if="{{woundCanApply}}" bindtap="applyWound">{{woundApplyLabel}}并记录</button>
      <button class="dialog-btn confirm" wx:else bindtap="applyWound">✅ 确认并记录</button>
    </view>
  </view>

  <!-- ===== 受伤记录编辑弹窗 ===== -->
  <view class="dialog-overlay {{showWoundEdit ? 'active' : ''}}" bindtap="closeWoundEdit" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showWoundEdit ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">✎ 编辑受伤记录</text>
    <view class="dialog-body-padded">
      <view class="form-group">
        <text class="form-label">伤痕</text>
        <input class="form-input" value="{{char.wounds[woundEditIdx].t}}" disabled placeholder="伤痕名称" />
      </view>
      <view class="form-group">
        <text class="form-label">详情</text>
        <textarea class="form-textarea" value="{{woundEditD}}" bindinput="onWoundEditInput" placeholder="伤痕详情…" maxlength="-1" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn danger" bindtap="confirmDeleteWound">🗑 删除记录</button>
      <button class="dialog-btn cancel" bindtap="closeWoundEdit">取消</button>
      <button class="dialog-btn confirm" bindtap="saveWoundEdit">保存</button>
    </view>
  </view>

  <!-- ===== 冒险家信息编辑弹窗 ===== -->
  <view class="dialog-overlay {{showProfileEdit ? 'active' : ''}}" bindtap="closeProfileEdit" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showProfileEdit ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">✎ 编辑冒险家信息</text>
    <view class="dialog-body-padded">
      <view class="form-group">
        <text class="form-label">冒险者名称</text>
        <input class="form-input" value="{{editProfile.name}}" bindinput="onEditProfileInput" data-field="name" placeholder="角色名称" />
      </view>
      <view class="form-group">
        <text class="form-label">出身</text>
        <input class="form-input" value="{{editProfile.background}}" bindinput="onEditProfileInput" data-field="background" placeholder="例如：猎人" />
      </view>
      <view class="form-group">
        <text class="form-label">年龄</text>
        <input class="form-input" type="number" value="{{editProfile.age}}" bindinput="onEditProfileInput" data-field="age" placeholder="例如：27" />
      </view>
      <view class="form-group">
        <text class="form-label">特质描述</text>
        <textarea class="form-textarea" value="{{editProfile.desc}}" bindinput="onEditProfileInput" data-field="desc" placeholder="体格、面容、言谈、美德、厄运…" maxlength="-1" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeProfileEdit">取消</button>
      <button class="dialog-btn confirm" bindtap="saveProfileEdit">保存</button>
    </view>
  </view>

</view>
