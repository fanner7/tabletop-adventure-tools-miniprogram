page {
  background: #f5f0e8;
}
.page {
  --theme-safe-top: 114rpx;
  background: #f5f0e8;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

/* Hero */
.hero {
  text-align: center;
  padding: 48rpx 28rpx;
}
.hero-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}
.hero-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3b2e1e;
  display: block;
}
.hero-sub {
  font-size: 22rpx;
  color: #8b7355;
  display: block;
  margin-top: 6rpx;
}
.hero-ver {
  font-size: 22rpx;
  color: #b0a590;
  display: block;
  margin-top: 10rpx;
}

/* Sections */
.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b2e1e;
  display: block;
  margin-bottom: 12rpx;
}
.section-text {
  font-size: 26rpx;
  color: #5a4a3a;
  line-height: 1.8;
  display: block;
}

/* Theme settings */
.theme-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.theme-option {
  min-height: 76rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d4c5a9;
  background: #faf8f4;
  color: #6b4c2a;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.theme-option:active {
  background: #f0ece5;
}

.theme-option.active {
  background: #6b4c2a;
  border-color: #6b4c2a;
  color: #ffffff;
}

.theme-option-title {
  font-size: 24rpx;
  font-weight: bold;
}

.theme-status {
  margin-top: 14rpx;
  color: #8b7355;
  font-size: 22rpx;
  text-align: center;
}

/* Tags */
.tag-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  background: #f5f0e8;
  border: 1rpx solid #d4c5a9;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #6b4c2a;
}

/* Link */
.link-row {
  margin: 14rpx 0;
  padding: 16rpx 20rpx;
  background: #faf8f4;
  border: 1rpx solid #d4c5a9;
  border-radius: 10rpx;
  text-align: center;
}
.link-row:active {
  background: #f0ece5;
}
.link-text {
  font-size: 24rpx;
  color: #6b4c2a;
}

.footnote {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b0a590;
}

.theme-dark.page {
  background: #111827;
}

.theme-dark .card {
  background: #1d2636;
  border: 1rpx solid #2f3b50;
  box-shadow: 0 8rpx 22rpx rgba(0,0,0,0.20);
}

.theme-dark .hero-title,
.theme-dark .section-title {
  color: #f4efe4;
}

.theme-dark .hero-sub,
.theme-dark .section-text {
  color: #aab6c8;
}

.theme-dark .hero-ver,
.theme-dark .footnote,
.theme-dark .theme-status {
  color: #768398;
}

.theme-dark .tag {
  background: #243044;
  border-color: #3a4a62;
  color: #d5a95c;
}

.theme-dark .link-row,
.theme-dark .theme-option {
  background: #243044;
  border-color: #3a4a62;
  color: #d5a95c;
}

.theme-dark .link-row:active,
.theme-dark .theme-option:active {
  background: #2d3b52;
}

.theme-dark .theme-option.active {
  background: #d5a95c;
  border-color: #d5a95c;
  color: #111827;
}

.theme-dark .link-text {
  color: #d5a95c;
}
