/* pages/liminal-horror-gen/liminal-horror-gen.wxss — 阈限恐怖 · 后室黄主题 */

page { padding-top:90rpx; box-sizing:border-box; background:#e8e4db; color:#1a1a1a; font-family:-apple-system,sans-serif; min-height:100vh; }
.lh-container { width:100%; max-width:600px; margin:0 auto; padding:0 12px 120px; box-sizing:border-box; }

/* ===== 页面头部 ===== */
.header { text-align:center; padding:32rpx 0 16rpx; border-bottom:2px solid #d5d0c8; margin-bottom:16rpx; }
.header-title { font-size:38rpx; font-weight:bold; color:#1a1a1a; display:block; }
.header-subtitle { font-size:22rpx; color:#777; display:block; margin-top:6rpx; }
.section-title { font-size:28rpx; font-weight:bold; color:#1a1a1a; margin-bottom:12rpx; display:block; }
.empty-hint { text-align:center; padding:40rpx 0; color:#aaa; font-size:26rpx; }

/* ===== 按钮 ===== */
.btn { width:100%; padding:24rpx 0; border-radius:12rpx; font-size:30rpx; font-weight:bold; text-align:center; border:none; margin-bottom:14rpx; }
.btn-primary { background:#8b6914; color:#fff; }
.btn-primary:active { background:#6b4f0e; }
.btn-import { width:100%; padding:24rpx 0; border-radius:12rpx; font-size:28rpx; font-weight:bold; text-align:center; border:1px dashed #8b6914; background:transparent; color:#8b6914; margin-bottom:14rpx; }
.btn-import:active { background:rgba(139,105,20,0.08); }

/* ===== 角色列表 ===== */
.char-list { margin-top:12rpx; }
.char-item { background:#fff; border-radius:10rpx; padding:16rpx 20rpx; margin-bottom:10rpx; display:flex; align-items:center; justify-content:space-between; border-left:6rpx solid #8b6914; box-shadow:0 1px 4px rgba(0,0,0,0.05); }
.char-item-info { flex:1; }
.char-item-head { display:flex; justify-content:space-between; align-items:baseline; }
.char-item-name { font-size:28rpx; font-weight:bold; color:#1a1a1a; display:block; }
.char-item-time { font-size:20rpx; color:#b0a090; flex-shrink:0; margin-left:12rpx; }
.char-item-meta { font-size:22rpx; color:#666; margin-top:2rpx; display:block; }
.char-item-del { font-size:32rpx; color:#ccc; padding:4rpx 6rpx; }

/* ===== 角色卡导航栏 ===== */
.play-header { display:flex; align-items:center; padding:12rpx 0; border-bottom:2px solid #d5d0c8; margin-bottom:14rpx; gap:8rpx; }
.back-btn { font-size:26rpx; color:#8b6914; padding:4rpx 6rpx; font-weight:bold; flex-shrink:0; }
.play-name-input { flex:1; height:56rpx; font-size:28rpx; font-weight:bold; color:#1a1a1a; text-align:center; background:transparent; border:none; }
.play-save { font-size:32rpx; padding:4rpx 6rpx; color:#8b6914; flex-shrink:0; }

/* ===== 通用卡片 ===== */
.card { background:#fff; border-radius:12rpx; padding:18rpx; margin-bottom:12rpx; box-shadow:0 1px 6px rgba(0,0,0,0.05); }
.card-title { font-size:26rpx; font-weight:bold; color:#1a1a1a; display:block; margin-bottom:10rpx; }

/* ===== 属性卡片 ===== */
.attr-card { display:flex; gap:10rpx; padding:14rpx; }
.attr-mini { flex:1; border-radius:10rpx; padding:16rpx 6rpx 12rpx; text-align:center; }
.attr-mini.str { background:#fdf3ea; border:1px solid #f0d5bb; }
.attr-mini.agi { background:#fdf8ed; border:1px solid #e0d5a0; }
.attr-mini.wil { background:#eef3f9; border:1px solid #c5d4e8; }
.attr-mini:active { opacity:.75; }
.am-val { font-size:44rpx; font-weight:bold; display:block; }
.am-max { font-size:24rpx; font-weight:normal; color:#888; }
.attr-mini.str .am-val { color:#d4782f; }
.attr-mini.agi .am-val { color:#8b6914; }
.attr-mini.wil .am-val { color:#3d7ab8; }
.am-label { font-size:20rpx; color:#666; display:block; margin:4rpx 0; }
.am-btns { display:flex; gap:6rpx; justify-content:center; }
.am-pm { display:inline-block; width:40rpx; height:40rpx; line-height:40rpx; border-radius:8rpx; background:rgba(0,0,0,0.06); color:#444; font-size:22rpx; font-weight:bold; text-align:center; }
.am-pm:active { background:rgba(0,0,0,0.14); }

/* ===== HP / 护甲 / 稳定 ===== */
.hp-card-row { display:flex; gap:12rpx; align-items:stretch; }
.hp-block { flex:1; background:#fdf5f5; border-radius:10rpx; padding:14rpx; text-align:center; display:flex; flex-direction:column; align-items:center; gap:6rpx; }
.hpl { font-size:22rpx; color:#666; }
.hpv { font-size:36rpx; font-weight:bold; color:#c0392b; }
.luck-block { background:#fffdf5; border:1px solid #f0e4b0; }
.luck-v { color:#8b6914; }
.ag-block { flex:1; display:flex; flex-direction:column; gap:8rpx; }
.ag-item { display:flex; align-items:center; justify-content:center; gap:8rpx; background:#f8f7f5; border-radius:8rpx; padding:10rpx 8rpx; }
.agl { font-size:20rpx; color:#666; }
.ag-inp { width:80rpx; height:44rpx; background:#fff; border:1px solid #d5d0c8; border-radius:6rpx; text-align:center; font-size:26rpx; font-weight:bold; color:#1a1a1a; }
.coins-row { flex-wrap:wrap; gap:4rpx; }
.coin-inp { width:120rpx; height:44rpx; background:#fff; border:1px solid #d5d0c8; border-radius:4rpx; text-align:center; font-size:26rpx; font-weight:bold; color:#1a1a1a; }
.coin-inp.big { font-size:32rpx; }
.coin-label { font-size:18rpx; color:#666; font-weight:bold; }

/* ===== 状态 ===== */
.cond-row { display:flex; flex-wrap:wrap; gap:8rpx; }
.cond-chip { padding:8rpx 16rpx; background:#f6f4f0; border:1px solid #e5e1d9; border-radius:16rpx; font-size:22rpx; color:#888; }
.cond-chip.on { background:#fdf5f5; border-color:#e0b0b0; color:#c0392b; font-weight:bold; }
.cond-chip:active { background:#ebe7e0; }

/* ===== 背包 ===== */
.inv-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:8rpx; }
.inv-head .card-title { margin-bottom:0; }
.inv-actions { display:flex; gap:10rpx; margin-top:14rpx; }
.btn-fatigue-lg { flex:1; padding:18rpx 0; background:#f6f4f0; color:#8b6914; border:1px solid #d5d0c8; border-radius:10rpx; font-size:22rpx; font-weight:bold; text-align:center; }
.btn-fatigue-lg:active { background:#ebe7e0; }
.inv-slot { display:flex; align-items:center; gap:6rpx; padding:5rpx 0; }
.inv-idx { font-size:20rpx; color:#bbb; width:36rpx; text-align:center; flex-shrink:0; }
.inv-input { flex:1; height:46rpx; background:#f8f7f5; border:1px solid #e5e1d9; border-radius:4rpx; padding:0 10rpx; font-size:22rpx; color:#1a1a1a; }
.inv-del { font-size:28rpx; color:#ccc; padding:4rpx 6rpx; }
.inv-del:active { color:#c0392b; }

/* ===== 掷骰 ===== */
.dice-row { display:flex; flex-wrap:wrap; gap:8rpx; }
.dice-btn-wrap { position:relative; width:calc(25% - 6rpx); }
.dice-btn { display:block; width:100%; padding:14rpx 0; background:#f6f4f0; border:1px solid #d5d0c8; border-radius:8rpx; font-size:24rpx; font-weight:bold; color:#1a1a1a; text-align:center; }
.dice-btn.sel { background:#8b6914; color:#fff; border-color:#8b6914; }
.dice-badge { position:absolute; top:-8rpx; right:-8rpx; min-width:32rpx; height:32rpx; line-height:32rpx; background:#555; color:#fff; border-radius:16rpx; font-size:18rpx; font-weight:bold; text-align:center; padding:0 6rpx; }
.dice-actions { display:flex; gap:10rpx; margin-top:12rpx; }
.btn-roll { flex:2; padding:18rpx 0; background:#8b6914; color:#fff; border:none; border-radius:10rpx; font-size:26rpx; font-weight:bold; text-align:center; }
.btn-roll:active { background:#6b4f0e; }
.btn-roll.rolling { background:#a0a090; }
.btn-clear { flex:1; padding:18rpx 0; background:transparent; color:#666; border:1px solid #d5d0c8; border-radius:10rpx; font-size:24rpx; text-align:center; }
.btn-clear:active { background:#f0ece5; }

.dice-result-highlight { margin-top:8rpx; margin-bottom:12rpx; padding:20rpx; background:#2d2410; border-radius:12rpx; text-align:center; }
.drh-total { font-size:72rpx; font-weight:bold; color:#e8e4db; display:block; line-height:1.1; }
.drh-dice { display:flex; flex-wrap:wrap; gap:8rpx; justify-content:center; margin-top:12rpx; }
.drh-chip { display:inline-block; padding:6rpx 14rpx; background:rgba(255,255,255,0.10); color:#bfb890; border-radius:20rpx; font-size:20rpx; }
.dice-rolling-hint { text-align:center; padding:20rpx 0; font-size:28rpx; color:#666; }
.dice-log { margin-top:10rpx; border-top:1px solid #e5e1d9; padding-top:8rpx; }
.dl-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:6rpx; }
.dl-title { font-size:22rpx; color:#888; font-weight:bold; }
.dl-clear { font-size:22rpx; color:#bbb; padding:2rpx 6rpx; }
.dl-clear:active { color:#c0392b; }
.dl-item { display:block; font-size:22rpx; color:#1a1a1a; padding:4rpx 0; border-bottom:1px solid #f0ece5; }
.dl-detail { font-size:18rpx; color:#888; }
.dl-time { font-size:18rpx; color:#bbb; margin-left:8rpx; }

/* ===== 细节 ===== */
.detail-row { display:flex; padding:8rpx 0; border-bottom:1px solid #f6f4f0; }
.detail-row:last-child { border-bottom:none; }
.dlbl { font-size:22rpx; color:#888; width:120rpx; flex-shrink:0; }
.dval { font-size:22rpx; color:#1a1a1a; flex:1; line-height:1.5; }

/* ===== 笔记 ===== */
.notes-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }
.notes-toggle { font-size:22rpx; color:#8b6914; padding:2rpx 6rpx; }
.notes-area { width:100%; min-height:60rpx; max-height:200rpx; background:#f8f7f5; border:1px solid #e5e1d9; border-radius:8rpx; padding:14rpx; font-size:24rpx; color:#1a1a1a; box-sizing:border-box; }
.notes-area.expanded { max-height:none; min-height:200rpx; }

/* ===== 底部双按钮 ===== */
.bottom-btns { display:flex; gap:12rpx; margin-top:8rpx; }
.btn-subtle { padding:24rpx 0; background:#f6f4f0; color:#555; border:1px solid #d5d0c8; border-radius:12rpx; font-size:30rpx; font-weight:bold; text-align:center; }
.btn-subtle:active { background:#ebe7e0; }

/* ===== 底部弹窗通用 ===== */
.dialog-sheet { position:fixed; bottom:0; left:0; right:0; background:#fff; border-radius:24rpx 24rpx 0 0; z-index:201; transform:translateY(100%); transition:transform .3s; display:flex; flex-direction:column; max-height:80vh; }
.dialog-sheet.active { transform:translateY(0); }
.dialog-handle { width:60rpx; height:6rpx; background:#d5d0c8; border-radius:3rpx; margin:16rpx auto; }
.dialog-title { font-size:32rpx; font-weight:bold; color:#1a1a1a; text-align:center; padding:0 32rpx 16rpx; display:block; }
.dialog-actions { display:flex; gap:16rpx; padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom,20rpx)); }
.dialog-btn { flex:1; padding:24rpx 0; border-radius:12rpx; font-size:28rpx; font-weight:bold; text-align:center; border:none; }
.dialog-btn.confirm { background:#8b6914; color:#fff; }
.dialog-btn.confirm:active { background:#6b4f0e; }
.dialog-btn.cancel { background:#f6f4f0; color:#555; }
.dialog-btn.cancel:active { background:#ebe7e0; }

.export-options { padding:0 32rpx 8rpx; }
.export-option { background:#f8f7f5; border:1px solid #e5e1d9; border-radius:12rpx; padding:22rpx 20rpx; }
.export-option:active { background:#ebe7e0; }
.export-option-text { }
.export-option-title { font-size:28rpx; font-weight:bold; color:#1a1a1a; display:block; margin-bottom:6rpx; }
.export-option-desc { font-size:22rpx; color:#888; display:block; line-height:1.4; }

/* ===== 新建角色命名弹窗 ===== */
.name-dialog-body { padding:0 32rpx 16rpx; }
.module-tabs { display:flex; gap:0; margin-bottom:20rpx; border-radius:10rpx; overflow:hidden; border:1px solid #d5d0c8; }
.module-tab { flex:1; padding:16rpx 0; text-align:center; font-size:26rpx; font-weight:bold; color:#888; background:#f8f7f5; }
.module-tab.on { background:#8b6914; color:#fff; }
.module-tab:active { opacity:.8; }
.name-dialog-input { width:100%; height:72rpx; background:#f8f7f5; border:1px solid #d5d0c8; border-radius:10rpx; padding:0 20rpx; font-size:32rpx; font-weight:bold; color:#1a1a1a; text-align:center; box-sizing:border-box; }
.name-dialog-btns { display:flex; gap:12rpx; margin-top:16rpx; }
.name-pick-btn { flex:1; padding:18rpx 0; border-radius:10rpx; font-size:26rpx; font-weight:bold; text-align:center; }
.name-pick-btn.male { background:#eef3f9; border:1px solid #c5d4e8; color:#3d7ab8; }
.name-pick-btn.female { background:#fdf0f0; border:1px solid #e8c5c5; color:#c0392b; }
.name-pick-btn:active { opacity:.7; }

.dialog-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.45); z-index:200; opacity:0; visibility:hidden; transition:opacity .3s; }
.dialog-overlay.active { opacity:1; visibility:visible; }

/* ===== 豁免弹窗 ===== */
.check-popup { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) scale(.8); background:#fff; border-radius:20rpx; padding:40rpx 36rpx; z-index:201; text-align:center; opacity:0; visibility:hidden; transition:all .3s; width:460rpx; box-shadow:0 8px 32px rgba(0,0,0,0.18); }
.check-popup.active { opacity:1; visibility:visible; transform:translate(-50%,-50%) scale(1); }
.check-title { font-size:30rpx; font-weight:bold; color:#1a1a1a; display:block; margin-bottom:8rpx; }
.check-target { font-size:22rpx; color:#666; display:block; margin-bottom:14rpx; }
.check-roll { font-size:60rpx; font-weight:bold; color:#1a1a1a; display:block; margin-bottom:10rpx; }
.check-result { font-size:34rpx; font-weight:bold; display:block; margin-bottom:20rpx; }
.check-result.success { color:#8b6914; }
.check-result.fail { color:#c0392b; }

/* ===== 页脚注 ===== */
.lh-attribution { position:fixed; bottom:0; left:0; right:0; text-align:center; padding:16rpx 0 calc(16rpx + env(safe-area-inset-bottom, 20rpx)); }
.lh-attribution text { font-size:22rpx; color:#b0a090; }

/* ============================== */
/* ===== 暗色主题 ===== */
/* ============================== */

.theme-dark.lh-container { background:#111827; color:#e6edf7; }

.theme-dark .header,
.theme-dark .play-header { border-bottom-color:#2f3b50; }

.theme-dark .header-title,
.theme-dark .section-title,
.theme-dark .play-name-input,
.theme-dark .card-title,
.theme-dark .dialog-title,
.theme-dark .check-title,
.theme-dark .check-roll,
.theme-dark .export-option-title { color:#f4efe4; }

.theme-dark .char-item-name,
.theme-dark .dval,
.theme-dark .dl-item { color:#f4efe4; }

.theme-dark .char-item-time { color:#768398; }

.theme-dark .header-subtitle,
.theme-dark .char-item-meta,
.theme-dark .am-label,
.theme-dark .hpl,
.theme-dark .agl,
.theme-dark .coin-label,
.theme-dark .export-option-desc,
.theme-dark .dice-rolling-hint,
.theme-dark .dl-title,
.theme-dark .dl-detail,
.theme-dark .dl-time,
.theme-dark .lh-attribution text,
.theme-dark .empty-hint,
.theme-dark .dlbl,
.theme-dark .check-target { color:#aab6c8; }

.theme-dark .card,
.theme-dark .char-item,
.theme-dark .dialog-sheet,
.theme-dark .check-popup,
.theme-dark .export-option { background:#1d2636; border-color:#33435b; box-shadow:0 8rpx 22rpx rgba(0,0,0,0.22); }

.theme-dark .btn-primary,
.theme-dark .btn-roll,
.theme-dark .dialog-btn.confirm,
.theme-dark .dice-btn.sel { background:#a68b30; color:#fff; border-color:#a68b30; }

.theme-dark .btn-primary:active,
.theme-dark .btn-roll:active,
.theme-dark .dialog-btn.confirm:active { background:#7a5c18; }

.theme-dark .btn-import,
.theme-dark .back-btn,
.theme-dark .notes-toggle,
.theme-dark .play-save { color:#c4a840; border-color:#c4a840; }

.theme-dark .btn-import:active { background:rgba(196,168,64,0.10); }

.theme-dark .attr-mini.str { background:#332a24; border-color:#5b4030; }
.theme-dark .attr-mini.agi { background:#2d2818; border-color:#4a4020; }
.theme-dark .attr-mini.wil { background:#1d2d43; border-color:#315077; }

.theme-dark .hp-block { background:#332525; }
.theme-dark .luck-block { background:#2d281a; border-color:#5b4a1a; }

.theme-dark .ag-item,
.theme-dark .btn-fatigue-lg,
.theme-dark .inv-input,
.theme-dark .ag-inp,
.theme-dark .coin-inp,
.theme-dark .dice-btn,
.theme-dark .btn-clear,
.theme-dark .notes-area,
.theme-dark .dialog-btn.cancel,
.theme-dark .cond-chip { background:#243044; border-color:#3a4a62; color:#e6edf7; }

.theme-dark .cond-chip.on { background:#3d1a22; border-color:#8b3a3a; color:#f87171; }

.theme-dark .btn-fatigue-lg,
.theme-dark .btn-subtle { color:#c4a840; }

.theme-dark .btn-fatigue-lg:active,
.theme-dark .btn-clear:active,
.theme-dark .btn-subtle:active,
.theme-dark .dialog-btn.cancel:active,
.theme-dark .export-option:active { background:#2d3b52; }

.theme-dark .name-dialog-input { background:#243044; border-color:#3a4a62; color:#e6edf7; }
.theme-dark .module-tabs { border-color:#3a4a62; }
.theme-dark .module-tab { background:#243044; color:#6b7a90; }
.theme-dark .module-tab.on { background:#a68b30; color:#fff; }
.theme-dark .name-pick-btn.male { background:#1d2d43; border-color:#315077; color:#68a7ff; }
.theme-dark .name-pick-btn.female { background:#332525; border-color:#5b4040; color:#ff7b72; }

.theme-dark .am-pm { background:rgba(255,255,255,0.08); color:#e6edf7; }

.theme-dark .inv-idx,
.theme-dark .inv-del,
.theme-dark .char-item-del,
.theme-dark .dl-clear { color:#768398; }

.theme-dark .dice-result-highlight { background:#1f1a0d; border:1rpx solid #3d301a; }
.theme-dark .drh-total { color:#f4efe4; }
.theme-dark .drh-chip { color:#bfb890; }
.theme-dark .dice-log,
.theme-dark .dl-item,
.theme-dark .detail-row { border-color:#2f3b50; }
.theme-dark .dl-item { color:#e6edf7; }
.theme-dark .hpv { color:#ff7b72; }
.theme-dark .luck-v { color:#c4a840; }

.theme-dark .dialog-handle { background:#3a4a62; }
.theme-dark .dialog-overlay { background:rgba(0,0,0,0.62); }

.theme-dark .check-result.success { color:#c4a840; }
.theme-dark .check-result.fail { color:#ff7b72; }

/* ===== 商店弹窗 ===== */
.shop-search-bar { padding:0 32rpx 12rpx; }
.shop-search-input { width:100%; height:64rpx; background:#f8f7f5; border:1px solid #d5d0c8; border-radius:8rpx; padding:0 16rpx; font-size:26rpx; color:#1a1a1a; box-sizing:border-box; }
.shop-scroll { max-height:55vh; }
.shop-cat-title { display:block; padding:18rpx 32rpx 10rpx; font-size:26rpx; font-weight:bold; color:#8b6914; background:#fdf8ed; }
.shop-row { display:flex; align-items:center; gap:16rpx; padding:16rpx 32rpx; border-bottom:1px solid #efebe3; }
.shop-row:active { background:#f8f7f5; }
.shop-info { flex:1; min-width:0; }
.shop-name { font-size:28rpx; font-weight:bold; color:#1a1a1a; display:block; line-height:1.3; }
.shop-desc { display:flex; flex-wrap:wrap; gap:6rpx; margin-top:4rpx; }
.shop-tag { font-size:20rpx; background:#f6f4f0; color:#888; padding:2rpx 10rpx; border-radius:6rpx; }
.shop-tag-bulky { background:#fdf5f5; color:#c0392b; }
.shop-price { font-size:28rpx; font-weight:bold; color:#8b6914; flex-shrink:0; min-width:80rpx; text-align:right; }
.shop-add { width:48rpx; height:48rpx; line-height:48rpx; text-align:center; background:#8b6914; color:#fff; border-radius:50%; font-size:28rpx; font-weight:bold; flex-shrink:0; }
.shop-add:active { background:#6b4f0e; }
.shop-empty { text-align:center; color:#bbb; padding:60rpx 0; font-size:26rpx; }

.theme-dark .shop-search-input { background:#243044; border-color:#3a4a62; color:#e6edf7; }
.theme-dark .shop-cat-title { background:#2d2818; color:#c4a840; }
.theme-dark .shop-row { border-color:#2f3b50; }
.theme-dark .shop-row:active { background:#243044; }
.theme-dark .shop-name { color:#f4efe4; }
.theme-dark .shop-price { color:#c4a840; }
.theme-dark .shop-tag { background:#243044; color:#aab6c8; }
