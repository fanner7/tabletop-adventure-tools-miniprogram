/* ===== 页面基调 ===== */
page {
  background: #1a1f25;
}
.page {
  --theme-safe-top: 114rpx;
  background: #1a1f25;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* ===== 结果展示区 ===== */
.result-stage {
  background: #222830;
  border-radius: 20rpx;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}
.result-stage.has-result {
  border-color: #333840;
  background: #1e242c;
}
.result-stage.rolling {
  border-color: #f1c40f30;
}

.stage-hint {
  font-size: 28rpx;
  color: #555a63;
}

.shake-hint {
  font-size: 22rpx;
  color: #4a5058;
  margin-top: 10rpx;
}

.result-total {
  font-size: 120rpx;
  font-weight: 800;
  color: #f0e6d3;
  line-height: 1;
  margin-bottom: 24rpx;
  font-variant-numeric: tabular-nums;
  animation: popIn 0.3s ease-out;
}

@keyframes popIn {
  0% { transform: scale(0.5); opacity: 0; }
  70% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: center;
}

.result-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid;
}

.chip-label {
  font-size: 24rpx;
  opacity: 0.7;
}

.chip-val {
  font-size: 30rpx;
  font-weight: bold;
}

/* 投掷中动画 */
.rolling-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.rolling-text {
  font-size: 26rpx;
  color: #f1c40f;
}

/* ===== 快捷投掷 ===== */
.quick-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 22rpx;
  color: #555a63;
  font-weight: bold;
  flex-shrink: 0;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.quick-scroll {
  flex: 1;
  white-space: nowrap;
}

.quick-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  background: #2a313a;
  border: 1rpx solid #3a414a;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #aab0b8;
  margin-right: 10rpx;
  transition: all 0.15s;
}

.quick-chip:active {
  background: #3a424d;
  color: #f1c40f;
  border-color: #f1c40f60;
}

.quick-chip.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ===== 骰子卡片网格 ===== */
.dice-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

/* d100 占 2 格，填满 4×2 网格 */
.dice-grid .dice-card:nth-child(7) {
  grid-column: span 2;
}

.dice-card {
  position: relative;
  background: #252d38;
  border: 2rpx solid #2e3642;
  border-radius: 16rpx;
  padding: 24rpx 8rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.15s;
}

.dice-card:active {
  transform: scale(0.96);
}

.dice-card.active {
  border-color: var(--dice-color);
  border-width: 2rpx;
  box-shadow: inset 0 0 24rpx rgba(255,255,255,0.04);
}

.dice-card.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 平面骰子图形（按真实骰子外形特征绘制，统一 68×68rpx 尺寸） ===== */
.die-shape {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--dice-color);
  box-shadow: inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.20), inset 0 4rpx 6rpx rgba(255, 255, 255, 0.25);
  transition: transform 0.15s;
}
.dice-card.active .die-shape {
  transform: translateY(-4rpx) rotate(-5deg);
}

/* d4 正四面体 → 三角形（数字在底部宽处） */
.s-4 {
  clip-path: polygon(50% 8%, 94% 92%, 6% 92%);
  -webkit-clip-path: polygon(50% 8%, 94% 92%, 6% 92%);
  align-items: flex-end;
  padding-bottom: 9rpx;
  box-sizing: border-box;
}

/* d6 正方体 → 圆角方片 + 数字（方形缩小以匹配多边形的视觉面积） */
.s-6 {
  width: 56rpx;
  height: 56rpx;
  border-radius: 13rpx;
}

/* d8 正八面体 → 上下两个三角形（菱形 + 中缝线） */
.s-8 {
  clip-path: polygon(50% 6%, 94% 50%, 50% 94%, 6% 50%);
  -webkit-clip-path: polygon(50% 6%, 94% 50%, 50% 94%, 6% 50%);
}
.d8-line {
  position: absolute;
  left: 22%;
  right: 22%;
  top: 50%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.7);
}

/* d10 五角偏方三八面体 → 风筝形（平顶、尖底，内缩不顶边） */
.s-10 {
  clip-path: polygon(46% 6%, 54% 6%, 94% 40%, 50% 94%, 6% 40%);
  -webkit-clip-path: polygon(46% 6%, 54% 6%, 94% 40%, 50% 94%, 6% 40%);
}

/* d100 百分骰 → 球形（确有球形 d100） */
.s-100 {
  border-radius: 50%;
}

/* d12 正十二面体 → 五边形 */
.s-12 {
  clip-path: polygon(50% 4%, 92% 36%, 76% 92%, 24% 92%, 8% 36%);
  -webkit-clip-path: polygon(50% 4%, 92% 36%, 76% 92%, 24% 92%, 8% 36%);
}

/* d20 正二十面体 → 六边形（面朝视角的外轮廓） */
.s-20 {
  clip-path: polygon(50% 4%, 90% 27%, 90% 73%, 50% 96%, 10% 73%, 10% 27%);
  -webkit-clip-path: polygon(50% 4%, 90% 27%, 90% 73%, 50% 96%, 10% 73%, 10% 27%);
}

.die-num {
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.35);
}
/* 多位数字号递减，保证形状内可读 */
.s-4 .die-num { font-size: 26rpx; }
.s-10 .die-num, .s-12 .die-num, .s-20 .die-num { font-size: 22rpx; }
.s-100 .die-num { font-size: 16rpx; }

/* 投掷中：CSS 点骰翻滚 */
.rolling-die {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  background: #f1c40f;
  border-radius: 16rpx;
  box-shadow: inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.20), inset 0 4rpx 6rpx rgba(255, 255, 255, 0.28);
  animation: diceTumble 0.5s infinite ease-in-out;
}
@keyframes diceTumble {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-16rpx) rotate(16deg); }
  50% { transform: translateY(0) rotate(0deg); }
  75% { transform: translateY(8rpx) rotate(-12deg); }
}
.rd-pip {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1a1f25;
}
.rd-pip.p-tl { top: 12rpx; left: 12rpx; }
.rd-pip.p-tr { top: 12rpx; right: 12rpx; }
.rd-pip.p-c { top: 50%; left: 50%; transform: translate(-50%, -50%); }
.rd-pip.p-bl { bottom: 12rpx; left: 12rpx; }
.rd-pip.p-br { bottom: 12rpx; right: 12rpx; }

.dice-card-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #c0c6ce;
}

.dice-card.active .dice-card-name {
  color: var(--dice-color);
}

.dice-card-count {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: var(--dice-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dice-card-count text {
  font-size: 22rpx;
  font-weight: bold;
  color: #1a1f25;
}

/* ===== 操作按钮栏 ===== */
.action-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.btn-clear {
  flex: 1;
  padding: 20rpx 0;
  background: transparent;
  border: 1rpx solid #3a414a;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #7a828e;
  text-align: center;
}

.btn-clear:active {
  background: #252d38;
  color: #aab0b8;
}

.btn-roll {
  flex: 2;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #f1c40f, #e67e22);
  border: none;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1f25;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(241, 196, 15, 0.2);
}

.btn-roll:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-roll.disabled {
  background: #2e3642;
  color: #5a6068;
  box-shadow: none;
}

/* ===== 历史面板 ===== */
.history-panel {
  background: #222830;
  border-radius: 16rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.history-panel.open {
  max-height: 600rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx 12rpx;
  border-bottom: 1rpx solid #2e3642;
}

.history-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #aab0b8;
}

.history-clear {
  font-size: 22rpx;
  color: #555a63;
  padding: 4rpx 10rpx;
}

.history-clear:active {
  color: #e74c3c;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #252d38;
}

.hi-total {
  font-size: 28rpx;
  font-weight: bold;
  color: #f0e6d3;
  min-width: 56rpx;
}

.hi-dice {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.hi-chip {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.04);
}

.hi-time {
  font-size: 20rpx;
  color: #555a63;
  flex-shrink: 0;
}

.history-empty {
  padding: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #555a63;
}

.theme-dark.page {
  background: #1a1f25;
}

.theme-light.page {
  background: #f7f1e7;
  color: #2f281d;
}

.theme-light .result-stage {
  background: #fffaf2;
  border-color: #eadcc5;
  box-shadow: 0 4rpx 18rpx rgba(92,64,34,0.08);
}

.theme-light .result-stage.has-result {
  background: #fff6e8;
  border-color: #dec8a8;
}

.theme-light .result-stage.rolling {
  border-color: #d69d2538;
}

.theme-light .stage-hint {
  color: #9b8b7a;
}

.theme-light .shake-hint,
.theme-light .section-label,
.theme-light .hi-time,
.theme-light .history-empty {
  color: #a99a87;
}

.theme-light .result-total,
.theme-light .hi-total {
  color: #3b2e1e;
}

.theme-light .rolling-text {
  color: #c98216;
}

.theme-light .quick-chip {
  background: #fffaf2;
  border-color: #e2d2b8;
  color: #6b5a4a;
}

.theme-light .quick-chip:active {
  background: #f5ead8;
  color: #9a650c;
  border-color: #d69d25;
}

.theme-light .dice-card {
  background: #fffaf2;
  border-color: #e4d5bd;
  box-shadow: 0 2rpx 10rpx rgba(92,64,34,0.06);
}

.theme-light .dice-card.active {
  box-shadow: inset 0 0 26rpx rgba(107,76,42,0.06);
}

.theme-light .dice-card-name {
  color: #3b2e1e;
}

.theme-light .dice-card-count text {
  color: #1f2933;
}

.theme-light .btn-clear {
  border-color: #dccbb2;
  color: #7a6b58;
}

.theme-light .btn-clear:active {
  background: #fffaf2;
  color: #3b2e1e;
}

.theme-light .btn-roll {
  color: #2f220e;
  box-shadow: 0 6rpx 16rpx rgba(214, 157, 37, 0.20);
}

.theme-light .btn-roll.disabled {
  background: #e8ded0;
  color: #a99a87;
}

.theme-light .history-panel {
  background: #fffaf2;
  border: 1rpx solid #e4d5bd;
}

.theme-light .history-head {
  border-bottom-color: #eadcc5;
}

.theme-light .history-title {
  color: #5a4a3a;
}

.theme-light .history-clear {
  color: #9b8b7a;
}

.theme-light .history-item {
  border-bottom-color: #f0e4d3;
}

.theme-light .hi-chip {
  background: rgba(107,76,42,0.06);
}
