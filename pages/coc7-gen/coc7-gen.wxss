/* 游玩模式：HP/SAN/LUCK/MP 四个状态格两列排布，保证 − 输入框 ＋ / 最大值 一行放得下 */
.play-sheet .char-deriv.vital {
  flex: 1 1 calc(50% - 6rpx);
  min-width: calc(50% - 6rpx);
  max-width: calc(50% - 6rpx);
  box-sizing: border-box;
}

/* PC 宽窗口（容器 600px 上限、rpx 随窗口放大）：状态格改单列，避免输入行被挤压 */
@media (min-width: 600px) {
  .play-sheet .char-deriv.vital {
    flex: 1 1 100%;
    min-width: 100%;
    max-width: 100%;
