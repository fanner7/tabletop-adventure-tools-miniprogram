  <view class="dialog-sheet {{showPresetDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">📖 选择预置调查员</text>
    <text class="dialog-sub">洛氏经典职业 · 载入后可直接开始游戏</text>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="preset-list">
      <view class="preset-item" wx:for="{{presets}}" wx:key="id" bindtap="applyPresetCharacter" data-index="{{index}}">
        <text class="preset-emoji">{{item.emoji}}</text>
        <view class="preset-main">
          <view class="preset-name-row">
            <text class="preset-name">{{item.name}}</text>
            <text class="preset-gender">{{item.gender}}</text>
          </view>
          <text class="preset-occ">{{item.occ}} · {{item.age}} 岁</text>
          <text class="preset-tag">{{item.tagline}}</text>
        </view>
        <text class="preset-arrow">›</text>
      </view>
    </scroll-view>
    <button class="dialog-btn cancel preset-close" bindtap="closePresetDialog">关闭</button>
  </view>

  <!-- ===== 标签编辑 dialog ===== -->
  <view class="dialog-overlay {{showTagDialog ? 'active' : ''}}" bindtap="closeTagDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showTagDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">✎ 编辑标签</text>
    <text class="dialog-sub">给调查员分组，如「周末团-阿卡姆」「SOLO」</text>
    <input class="form-input" placeholder="输入标签（留空清除）" value="{{tagInput}}" bindinput="onTagInput" />
    <view class="dialog-actions">
      <button class="dialog-btn confirm" bindtap="saveTag">保存</button>
      <button class="dialog-btn cancel" bindtap="closeTagDialog">取消</button>
    </view>
  </view>

