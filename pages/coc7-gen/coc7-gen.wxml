  <view class="dialog-overlay {{showFreeSlotDialog ? 'active' : ''}}" bindtap="closeFreeSlotDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showFreeSlotDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">选择职业技能</text>
    <text class="dialog-sub">选中的技能将获得职业技能资格，可用职业点加点</text>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="free-slot-list">
      <view class="free-slot-option" wx:for="{{freeSlotDialogList}}" wx:key="name" bindtap="pickFreeSlotSkill" data-name="{{item.name}}">
        <text class="free-slot-opt-name">{{item.name}}</text>
        <text class="free-slot-opt-base">基础 {{item.base}}%</text>
      </view>
      <view class="free-slot-empty" wx:if="{{freeSlotDialogList.length == 0}}">没有可选的技能了</view>
    </scroll-view>
    <button class="dialog-btn cancel preset-close" bindtap="closeFreeSlotDialog">取消</button>
  </view>

  <!-- ===== 技能 dialog（底部弹出，含说明 + slider） ===== -->
  <view class="dialog-overlay {{showDialog ? 'active' : ''}}" bindtap="closeSkillDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title" wx:if="{{dialogSkill}}">{{dialogSkill.name}}</text>
    <text class="dialog-sub" wx:if="{{dialogSkill}}">
      {{dialogSkill.catName}} | 基础 {{dialogSkill.base}}%
      <text wx:if="{{!dialogReadonly}}"> | {{dialogSkill.isOcc ? '职业技能' : '兴趣技能'}}</text>
    </text>
    <!-- 可滚动内容区 -->
    <scroll-view class="dialog-body" scroll-y enhanced show-scrollbar="{{false}}">
