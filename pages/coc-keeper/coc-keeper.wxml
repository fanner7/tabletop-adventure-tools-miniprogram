            <text class="task-io-desc">从剪贴板读取任务数据（JSON）</text>
          </view>
        </view>
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeExportTask">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 检定助手 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showCheckDialog ? 'active' : ''}}" bindtap="closeCheckDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showCheckDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🎯 检定</text>
    <view class="dialog-body-padded">
      <view class="check-info">
        <text class="check-skill">{{checkTitle}}</text>
        <text class="check-total">目标值 {{checkTotal}}%</text>
      </view>
      <view class="check-mode-row">
        <view class="dice100-mode {{checkMode === 'normal' ? 'on' : ''}}" bindtap="setCheckMode" data-mode="normal">普通</view>
        <view class="dice100-mode {{checkMode === 'bonus' ? 'on' : ''}}" bindtap="setCheckMode" data-mode="bonus">🎁 奖励</view>
        <view class="dice100-mode {{checkMode === 'penalty' ? 'on' : ''}}" bindtap="setCheckMode" data-mode="penalty">😈 惩罚</view>
      </view>
      <button class="btn-roll" style="width:100%;box-sizing:border-box;margin-top:16rpx;" bindtap="doCheckRoll" disabled="{{checkRolling}}">{{checkRolling ? '…掷骰中…' : '🎲 掷骰判定'}}</button>
      <view class="check-result" wx:if="{{checkDice}}">
        <text class="check-d100">{{checkDice.result}}</text>
        <text class="check-level {{checkLevel.cls}}">{{checkLevel.text}}</text>
        <text class="check-detail" wx:if="{{checkDice.mode !== 'normal'}}">十位 {{checkDice.tensStr}} 取 {{checkDice.chosen}} · 个位 {{checkDice.ones}}</text>
        <view class="check-again" bindtap="doCheckRoll">🔄 再掷一次</view>
      </view>
      <view class="check-damage" wx:if="{{checkAttack && checkDice}}">
        <view class="check-damage-btn" bindtap="doDamageRoll">💥 掷伤害</view>
        <view class="check-damage-result" wx:if="{{checkDamage}}">
          <text class="cd-expr">{{checkDamage.expr}}</text>
          <text class="cd-total">{{checkDamage.total}}</text>
          <text class="cd-parts" wx:if="{{checkDamage.partsStr}}">{{checkDamage.partsStr}}</text>
        </view>
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeCheckDialog">关闭</button>
    </view>
