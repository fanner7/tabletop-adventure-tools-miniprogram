    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeImportPlayerDialog">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 手动新建调查员 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showNewPlayer ? 'active' : ''}}" bindtap="closeNewPlayer" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showNewPlayer ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">✍️ 手动新建调查员</text>
    <view class="dialog-body-padded">
      <text class="dialog-hint" style="display:block;margin-bottom:12rpx;">除角色名称外均可选填，留空的项目不会展示</text>
      <view class="form-group">
        <text class="form-label">角色名称</text>
        <input class="form-input" placeholder="输入调查员名称" value="{{newPlayerName}}" bindinput="onNewPlayerNameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">职业（可选）</text>
        <input class="form-input" placeholder="例如：记者" value="{{newPlayerOcc}}" bindinput="onNewPlayerOccInput" />
      </view>
      <view class="form-group">
        <text class="form-label">HP 生命（可选）</text>
        <input class="form-input" type="number" placeholder="例如 12" value="{{newPlayerHp}}" bindinput="onNewPlayerHpInput" />
      </view>
      <view class="form-group">
        <text class="form-label">SAN 理智（可选）</text>
        <input class="form-input" type="number" placeholder="例如 60" value="{{newPlayerSan}}" bindinput="onNewPlayerSanInput" />
      </view>
      <view class="form-group">
        <text class="form-label">MP 魔法（可选）</text>
        <input class="form-input" type="number" placeholder="例如 12" value="{{newPlayerMp}}" bindinput="onNewPlayerMpInput" />
      </view>
      <view class="form-group">
        <text class="form-label">LUCK 幸运（可选）</text>
        <input class="form-input" type="number" placeholder="例如 50" value="{{newPlayerLuck}}" bindinput="onNewPlayerLuckInput" />
      </view>
      <view class="form-group">
        <text class="form-label">DEX 敏捷（可选，用于战斗轮）</text>
        <input class="form-input" type="number" placeholder="例如 55" value="{{newPlayerDex}}" bindinput="onNewPlayerDexInput" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeNewPlayer">取消</button>
      <button class="dialog-btn confirm" bindtap="confirmNewPlayer">添加</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- NPC 模板库 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showNpcTemplates ? 'active' : ''}}" bindtap="closeNpcTemplates" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showNpcTemplates ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🧟 NPC 模板库</text>
    <view class="dialog-body-padded">
      <view class="tpl-cats">
        <view class="tpl-cat {{tplCat === c.id ? 'on' : ''}}" wx:for="{{npcTemplateCats}}" wx:for-item="c" wx:key="id"
              bindtap="switchTplCat" data-id="{{c.id}}">{{c.icon}} {{c.name}}</view>
      </view>
      <text class="dialog-hint" style="display:block;margin:12rpx 0;">点击模板一键添加到当前任务（当前分类 {{npcTemplatesByCat[tplCat].length}} 个），数值为常见参考值，可在编辑中调整</text>
      <scroll-view scroll-y class="tpl-list">
        <view class="tpl-item" wx:for="{{npcTemplatesByCat[tplCat]}}" wx:for-item="t" wx:key="id"
              bindtap="addNpcFromTemplate" data-id="{{t.id}}">
          <text class="tpl-icon">{{t.icon}}</text>
          <view class="tpl-info">
            <text class="tpl-name">{{t.name}}<text class="tpl-stats"> · DEX {{t.dex}} · HP {{t.hp}} · MP {{t.mp}}</text></text>
            <text class="tpl-desc">{{t.desc}}</text>
          </view>
          <text class="tpl-add">＋</text>
        </view>
      </scroll-view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeNpcTemplates">关闭</button>
    </view>
  </view>

</view>
