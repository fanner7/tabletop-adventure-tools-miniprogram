  <!-- ================================================================== -->
  <!-- 创建任务 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showCreateTask ? 'active' : ''}}" bindtap="closeCreateTask" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showCreateTask ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">➕ 创建新任务</text>
    <view class="dialog-body-padded">
      <view class="form-group">
        <text class="form-label">任务名称</text>
        <input class="form-input" placeholder="输入任务名称（如：周六团）" value="{{createTaskName}}" bindinput="onTaskNameInput" focus="{{showCreateTask}}" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeCreateTask">取消</button>
      <button class="dialog-btn confirm" bindtap="confirmCreateTask">创建</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 编辑 NPC Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showEditNPC ? 'active' : ''}}" bindtap="closeEditNPC" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showEditNPC ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">{{editNpcIndex === -1 ? '➕ 新建 NPC' : '✎ 编辑 NPC'}}</text>
    <view class="dialog-body-padded">
      <view class="form-group">
        <text class="form-label">NPC 名称</text>
        <input class="form-input" placeholder="NPC 名称" value="{{editNpcName}}" bindinput="onEditNpcNameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">DEX（敏捷，可选）</text>
        <input class="form-input" type="number" placeholder="例如 50" value="{{editNpcDex}}" bindinput="onEditNpcDexInput" />
      </view>
      <view class="form-group">
        <text class="form-label">DB（伤害加值，可选）</text>
        <input class="form-input" placeholder="例如 +1D4 或 +0" value="{{editNpcDb}}" bindinput="onEditNpcDbInput" />
      </view>
      <view class="form-group">
        <text class="form-label">护甲（可选，留空则不展示）</text>
        <input class="form-input" placeholder="例如 1（皮肤）或 无（免疫普通武器）" value="{{editNpcArmor}}" bindinput="onEditNpcArmorInput" />
      </view>
      <view class="form-group">
        <text class="form-label">HP（生命值，可选）</text>
        <input class="form-input" type="number" placeholder="例如 12" value="{{editNpcHp}}" bindinput="onEditNpcHpInput" />
      </view>
      <view class="form-group">
        <text class="form-label">MP（魔法值，可选）</text>
        <input class="form-input" type="number" placeholder="例如 10" value="{{editNpcMp}}" bindinput="onEditNpcMpInput" />
      </view>
      <view class="form-group">
        <text class="form-label">攻击方式（可选，留空则不展示）</text>
        <input class="form-input" placeholder="例如：斗殴 1D3+DB / 手枪 1D10" value="{{editNpcAttack}}" bindinput="onEditNpcAttackInput" />
      </view>
      <view class="form-group">
        <text class="form-label">NPC 数据</text>
