          <text class="lex-w">{{it.w}}</text>
          <text class="lex-d" wx:if="{{it.d}}">{{it.d}}</text>
        </view>
      </scroll-view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeLexicon">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 线索表 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showCluesDialog ? 'active' : ''}}" bindtap="closeClues" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showCluesDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🔍 线索表</text>
    <view class="dialog-body-padded">
      <text class="dialog-hint" style="display:block;margin-bottom:8px;">备团时录入线索（可带地点与出处备注），带团时标记「已给」；支持按地点筛选与搜索，备用线索可单独查看</text>
      <view class="clue-add-row">
        <input class="form-input clue-input" placeholder="线索内容…" value="{{clueInput}}" bindinput="onClueInput" />
      </view>
      <view class="clue-add-row">
        <input class="form-input clue-input" placeholder="地点·场所级（可选）" value="{{clueLocInput}}" bindinput="onClueLocInput" />
        <input class="form-input clue-input" placeholder="出处/备注（可选）" value="{{clueSource}}" bindinput="onClueSourceInput" />
      </view>
      <view class="clue-add-row">
        <button class="btn-subtle" style="flex:1;" bindtap="addClue">＋ 添加</button>
      </view>
      <view class="clue-search-row">
        <input class="clue-search-input" placeholder="🔍 搜索线索…" value="{{clueSearch}}" bindinput="onClueSearchInput" />
      </view>
      <view class="clue-tags" wx:if="{{clueLocs.length > 0 || clueBackupCount > 0}}">
        <view class="tpl-cat {{clueLocFilter === '' ? 'on' : ''}}" bindtap="onClueLocTap" data-loc="">全部</view>
        <view class="tpl-cat {{clueLocFilter === t.loc ? 'on' : ''}}" wx:for="{{clueLocs}}" wx:for-item="t" wx:key="loc"
              bindtap="onClueLocTap" data-loc="{{t.loc}}">📍 {{t.loc}} {{t.count}}</view>
        <view class="tpl-cat {{clueLocFilter === '__backup__' ? 'on' : ''}}" wx:if="{{clueBackupCount > 0}}"
              bindtap="onClueLocTap" data-loc="__backup__">🎲 备用 {{clueBackupCount}}</view>
      </view>
      <view class="clue-item {{c.given ? 'given' : ''}}" wx:for="{{clueFiltered}}" wx:for-item="c" wx:key="id">
        <text class="clue-text">{{c.text}}</text>
        <text class="clue-source" wx:if="{{c.source}}">{{c.isBackup ? '🎲' : '📎'}} {{c.source}}</text>
        <view class="clue-loc-row" wx:if="{{c.location}}">
          <text class="clue-item-loc" catchtap="openClueLocEdit" data-id="{{c.id}}">📍 {{c.location}}</text>
        </view>
        <view class="clue-actions">
          <text class="clue-given {{c.given ? '' : 'off'}}" catchtap="toggleClueGiven" data-id="{{c.id}}">{{c.given ? '✓ 已给' : '○ 未给'}}</text>
          <text class="clue-addloc" wx:if="{{!c.location}}" catchtap="openClueLocEdit" data-id="{{c.id}}">＋地点</text>
          <text class="char-card-delete" catchtap="deleteClue" data-id="{{c.id}}">✕</text>
        </view>
      </view>
      <view class="empty-hint" wx:if="{{clueFiltered.length === 0}}"><text>{{currentTask.clues.length > 0 ? '没有匹配的线索' : '还没有线索，先录入一条吧'}}</text></view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeClues">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 线索地点编辑 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showClueLocEdit ? 'active' : ''}}" bindtap="closeClueLocEdit" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showClueLocEdit ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">📍 设置线索地点</text>
    <view class="dialog-body-padded">
      <view class="form-group">
        <text class="form-label">地点（留空 = 移除地点）</text>
        <input class="form-input" placeholder="如：科比特老房子 / 中央图书馆（场所级，房间等写出处）" value="{{clueLocEditValue}}" bindinput="onClueLocEditInput" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeClueLocEdit">取消</button>
      <button class="dialog-btn confirm" bindtap="saveClueLoc">保存</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 团务笔记 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showNotesDialog ? 'active' : ''}}" bindtap="closeNotes" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showNotesDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">📝 团务笔记</text>
    <view class="dialog-body-padded">
      <button class="btn-subtle" style="width:100%;box-sizing:border-box;text-align:center;margin-bottom:10rpx;" bindtap="addNote">＋ 新建笔记</button>
      <view class="note-item" wx:for="{{currentTask.notes}}" wx:for-item="nt" wx:key="id" bindtap="openNoteEdit" data-id="{{nt.id}}">
        <text class="note-title">{{nt.title || '未命名笔记'}}</text>
        <text class="note-preview">{{nt.content}}</text>
      </view>
      <view class="empty-hint" wx:if="{{!currentTask.notes || currentTask.notes.length === 0}}"><text>还没有笔记，点击「新建笔记」开始记录</text></view>
      <view class="note-actions" wx:if="{{currentTask.notes && currentTask.notes.length > 0}}">
        <button class="btn-subtle" style="width:100%;box-sizing:border-box;text-align:center;" bindtap="exportNotes">📋 导出全部笔记</button>
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeNotes">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 笔记编辑 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showNoteEdit ? 'active' : ''}}" bindtap="closeNoteEdit" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showNoteEdit ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">{{editNoteId === null ? '＋ 新建笔记' : '✎ 编辑笔记'}}</text>
    <view class="dialog-body-padded">
      <view class="form-group">
        <text class="form-label">标题</text>
        <input class="form-input" placeholder="笔记标题（如：洋馆·阁楼）" value="{{noteTitle}}" bindinput="onNoteTitleInput" />
      </view>
      <view class="form-group">
        <text class="form-label">内容</text>
        <textarea class="form-textarea" placeholder="场景描述、NPC 话术、剧情分支…" value="{{noteContent}}" bindinput="onNoteContentInput" auto-height maxlength="-1" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeNoteEdit">取消</button>
      <button class="dialog-btn cancel" bindtap="deleteNote" wx:if="{{editNoteId !== null}}">删除</button>
      <button class="dialog-btn confirm" bindtap="saveNote">保存</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 规则速查 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showRulesDialog ? 'active' : ''}}" bindtap="closeRules" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showRulesDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">📚 规则速查</text>
    <view class="dialog-body-padded">
      <view class="tpl-cats">
        <view class="tpl-cat {{rulesCat === s.id ? 'on' : ''}}" wx:for="{{rulesSections}}" wx:for-item="s" wx:key="id"
              bindtap="switchRulesCat" data-id="{{s.id}}">{{s.icon}} {{s.name}}</view>
      </view>
      <view class="rule-table" wx:if="{{rulesTable.length > 0}}">
        <view class="rule-cell" wx:for="{{rulesTable}}" wx:for-item="row" wx:key="index">
          <text class="rule-cell-name">{{row[0]}}</text>
          <text class="rule-cell-val">{{row[1]}}</text>
        </view>
      </view>
      <view class="rules-list">
        <view class="rule-item" wx:for="{{rulesItems}}" wx:for-item="it" wx:key="w">
          <text class="rule-w">{{it.w}}</text>
          <text class="rule-d">{{it.d}}</text>
        </view>
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeRules">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- AI 备团 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showAiDialog ? 'active' : ''}}" bindtap="closeAi" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showAiDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🤖 AI 备团</text>
    <view class="dialog-body-padded">
      <text class="dialog-hint" style="display:block;margin-bottom:8px;">本工具不内置 AI：把提示词与格式样例复制给任意 AI（附上你的模组文本），再把 AI 输出粘贴回来一键导入。</text>
      <view class="ai-copy-row">
        <view class="tpl-cat" bindtap="copyAiAll">📋 一键复制全部</view>
      </view>
      <view class="ai-copy-row">
        <view class="tpl-cat" bindtap="copyAiPrompt" data-type="npc">NPC 提示词</view>
        <view class="tpl-cat" bindtap="copyAiPrompt" data-type="clue">线索提示词</view>
        <view class="tpl-cat" bindtap="copyAiPrompt" data-type="note">笔记提示词</view>
      </view>
      <view class="ai-copy-row">
        <view class="tpl-cat" bindtap="copyAiSample" data-type="npc">NPC 样例</view>
        <view class="tpl-cat" bindtap="copyAiSample" data-type="clue">线索样例</view>
        <view class="tpl-cat" bindtap="copyAiSample" data-type="note">笔记样例</view>
      </view>
      <textarea class="form-textarea ai-paste" placeholder="把 AI 生成的 NPC / 线索 / 笔记粘贴到这里…" value="{{aiImportText}}" bindinput="onAiImportTextInput" maxlength="-1" />
      <view class="ai-import-row">
        <button class="btn-subtle" bindtap="importAiNpcs">📥 导入为 NPC</button>
        <button class="btn-subtle" bindtap="importAiClues">📥 导入为线索</button>
        <button class="btn-subtle" bindtap="importAiNotes">📥 导入为笔记</button>
      </view>
      <text class="dialog-hint" style="display:block;margin-top:10rpx;">格式：NPC 按「---」或空行分块；线索每行一条（内容｜地点｜出处，地点写场所级、房间等写出处，备用线索出处写「备用线索」）；笔记按「## 标题」分块（块内可空行）。</text>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeAi">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 导入 NPC Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showImportNpcDialog ? 'active' : ''}}" bindtap="closeImportNpcDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showImportNpcDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">📥 导入 NPC</text>
    <view class="dialog-body-padded">
      <text class="dialog-hint" style="display:block;margin-bottom:8px;">支持模组传统格式：第一行是名称，其余行自由排版，会自动识别 DEX / HP / MP / DB / 技能 / 攻击。可直接从 PDF 复制，或对线下材料拍照后用文字识别整理。</text>
      <view class="task-io-options">
        <view class="task-io-option" bindtap="doImportNpc">
          <text class="task-io-icon">📋</text>
          <view class="task-io-text">
            <text class="task-io-title">从剪贴板导入</text>
            <text class="task-io-desc">读取剪贴板中的 NPC 文本并解析</text>
          </view>
        </view>
        <view class="task-io-option" bindtap="openNewNPC">
          <text class="task-io-icon">✍️</text>
          <view class="task-io-text">
            <text class="task-io-title">手动新建 NPC</text>
            <text class="task-io-desc">直接填写名称 / 属性 / 攻击等（均可选）</text>
          </view>
        </view>
      </view>
      <text class="io-sample-title">📄 格式样例（可直接复制）</text>
      <view class="io-sample"><text style="white-space:pre-wrap;word-break:break-all;">{{npcSampleText}}</text></view>
      <button class="btn-subtle" style="width:100%;box-sizing:border-box;text-align:center;" bindtap="copyNpcSample">📋 复制样例</button>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeImportNpcDialog">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 导入调查员 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showImportPlayerDialog ? 'active' : ''}}" bindtap="closeImportPlayerDialog" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showImportPlayerDialog ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">📥 导入调查员</text>
    <view class="dialog-body-padded">
      <text class="dialog-hint" style="display:block;margin-bottom:8px;">推荐方式：在「🐙 COC 调查员工具」中创建/加载角色卡，点导出后复制，再回到这里粘贴导入（完整属性、技能、武器）。</text>
      <view class="task-io-options">
        <view class="task-io-option" bindtap="doImportPlayer">
          <text class="task-io-icon">📋</text>
          <view class="task-io-text">
            <text class="task-io-title">从剪贴板导入</text>
            <text class="task-io-desc">读取剪贴板中的调查员 JSON 数据</text>
          </view>
        </view>
        <view class="task-io-option" bindtap="openNewPlayer">
          <text class="task-io-icon">✍️</text>
          <view class="task-io-text">
            <text class="task-io-title">手动新建调查员</text>
            <text class="task-io-desc">填写角色名称与重要状态值即可（均可选）</text>
          </view>
        </view>
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeImportPlayerDialog">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 手动新建调查员 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showNewPlayer ? 'active' : ''}}" bindtap="closeNewPlayer" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showNewPlayer ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">✍️ 手动新建调查员</text>
    <view class="dialog-body-padded">
      <text class="dialog-hint" style="display:block;margin-bottom:8px;">除角色名称外均可选填，留空的项目不会展示</text>
      <view class="form-group">
        <text class="form-label">角色名称</text>
        <input class="form-input" placeholder="输入调查员名称" value="{{newPlayerName}}" bindinput="onNewPlayerNameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">职业（可选）</text>
        <input class="form-input" placeholder="例如：记者" value="{{newPlayerOcc}}" bindinput="onNewPlayerOccInput" />
      </view>
      <view class="form-group">
        <text class="form-label">HP 生命（可选）</text>
        <input class="form-input" type="number" placeholder="例如 12" value="{{newPlayerHp}}" bindinput="onNewPlayerHpInput" />
      </view>
      <view class="form-group">
        <text class="form-label">SAN 理智（可选）</text>
        <input class="form-input" type="number" placeholder="例如 60" value="{{newPlayerSan}}" bindinput="onNewPlayerSanInput" />
      </view>
      <view class="form-group">
        <text class="form-label">MP 魔法（可选）</text>
        <input class="form-input" type="number" placeholder="例如 12" value="{{newPlayerMp}}" bindinput="onNewPlayerMpInput" />
      </view>
      <view class="form-group">
        <text class="form-label">LUCK 幸运（可选）</text>
        <input class="form-input" type="number" placeholder="例如 50" value="{{newPlayerLuck}}" bindinput="onNewPlayerLuckInput" />
      </view>
      <view class="form-group">
        <text class="form-label">DEX 敏捷（可选，用于战斗轮）</text>
        <input class="form-input" type="number" placeholder="例如 55" value="{{newPlayerDex}}" bindinput="onNewPlayerDexInput" />
      </view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeNewPlayer">取消</button>
      <button class="dialog-btn confirm" bindtap="confirmNewPlayer">添加</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- NPC 模板库 Dialog -->
  <!-- ================================================================== -->
  <view class="dialog-overlay {{showNpcTemplates ? 'active' : ''}}" bindtap="closeNpcTemplates" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-sheet {{showNpcTemplates ? 'active' : ''}}">
    <view class="dialog-handle"></view>
    <text class="dialog-title">🧟 NPC 模板库</text>
    <view class="dialog-body-padded">
      <view class="tpl-cats">
        <view class="tpl-cat {{tplCat === c.id ? 'on' : ''}}" wx:for="{{npcTemplateCats}}" wx:for-item="c" wx:key="id"
              bindtap="switchTplCat" data-id="{{c.id}}">{{c.icon}} {{c.name}}</view>
      </view>
      <text class="dialog-hint" style="display:block;margin:8px 0;">点击模板一键添加到当前任务（当前分类 {{npcTemplatesByCat[tplCat].length}} 个），数值为常见参考值，可在编辑中调整</text>
      <scroll-view scroll-y class="tpl-list">
        <view class="tpl-item" wx:for="{{npcTemplatesByCat[tplCat]}}" wx:for-item="t" wx:key="id"
              bindtap="addNpcFromTemplate" data-id="{{t.id}}">
          <text class="tpl-icon">{{t.icon}}</text>
          <view class="tpl-info">
            <text class="tpl-name">{{t.name}}<text class="tpl-stats"> · DEX {{t.dex}} · HP {{t.hp}} · MP {{t.mp}}</text></text>
            <text class="tpl-desc">{{t.desc}}</text>
          </view>
          <text class="tpl-add">＋</text>
        </view>
      </scroll-view>
    </view>
    <view class="dialog-actions">
      <button class="dialog-btn cancel" bindtap="closeNpcTemplates">关闭</button>
    </view>
  </view>

  <!-- ================================================================== -->
  <!-- 桌面端布局模式切换栏（仅桌面平台显示） -->
  <!-- ================================================================== -->
  <view class="desk-modebar" wx:if="{{isDesktopPlatform}}">
    <text class="desk-mode-hint">{{isWide ? '🖥 全屏' : '📱 窄条'}} · {{winWidth}}×{{winHeight}}{{vpW ? ' · VP ' + vpW + '×' + vpH : ''}}{{statusBarH ? ' · 栏' + statusBarH : ''}}{{deskTopInsetRpx > 0 ? ' · 顶' + deskTopInsetRpx + 'rpx' : ''}}</text>
    <view class="desk-mode-btn {{layoutMode === 'auto' ? 'on' : ''}}" bindtap="onModeBtnTap" data-mode="auto">自动</view>
    <view class="desk-mode-btn {{layoutMode === 'wide' ? 'on' : ''}}" bindtap="onModeBtnTap" data-mode="wide">🖥 全屏</view>
    <view class="desk-mode-btn {{layoutMode === 'narrow' ? 'on' : ''}}" bindtap="onModeBtnTap" data-mode="narrow">📱 窄条</view>
    <view class="desk-mode-btn" bindtap="adjustTopInset" data-delta="1">顶+</view>
    <view class="desk-mode-btn" bindtap="adjustTopInset" data-delta="-1" wx:if="{{deskTopInsetRpx > 0}}">顶−</view>
    <view class="desk-mode-btn" bindtap="resetDeskLayout" wx:if="{{isWide}}">↺ 重置</view>
  </view>

</view>
