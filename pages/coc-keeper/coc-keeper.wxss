/* ===== 卡片阵营配色 / 低血量警示 ===== */
.player-card { background: #f5f9ff; border: 2px solid #b8d4fe; }
.npc-card { background: #fdf9f0; border: 2px solid #e0c9a8; }
.char-card.low { border-color: #e67e22; }
.char-card.dead { border-color: #c0392b; background: #fdf3f1; }
.npc-card.dead { border-color: #c0392b; background: #fdf3f1; }
.wound-badge {
  display: inline-block; font-size: 18rpx; color: #fff; background: #e67e22;
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 8rpx;
}

/* ===== 数值变化动效 ===== */
.npc-card-stat-val.flash { animation: statFlash 0.5s ease; }
@keyframes statFlash {
  0% { transform: scale(1.6); color: #e67e22; }
  100% { transform: scale(1); }
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  background: #faf8f4; border: 2px dashed #d4c5a9; border-radius: 16rpx;
  padding: 48rpx 32rpx; margin-top: 16rpx;
}
.empty-state-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.empty-state-title { font-size: 28rpx; font-weight: bold; color: #3b2e1e; margin-bottom: 8rpx; }
.empty-state-desc { font-size: 22rpx; color: #8b7355; text-align: center; line-height: 1.6; }

/* ===== 以上（暗色） ===== */
.theme-dark .player-card { background: #16283d; border-color: #31548c; }
.theme-dark .npc-card { background: #2a2018; border-color: #7d6a4a; }
.theme-dark .char-card.low { border-color: #e67e22; }
.theme-dark .char-card.dead,
.theme-dark .npc-card.dead { border-color: #c0392b; background: #2a1818; }
.theme-dark .wound-badge { background: #e67e22; color: #111827; }
.theme-dark .empty-state { background: #1a2233; border-color: #3a4a62; }
.theme-dark .empty-state-title { color: #f4efe4; }
.theme-dark .empty-state-desc { color: #8fa0b8; }

/* ===== 词汇表（暗色） ===== */
.theme-dark .lex-item {
  background: #1a2233;
  border-color: #2f3b50;
}
.theme-dark .lex-item:active { background: #243044; }
.theme-dark .lex-w { color: #f4efe4; }
.theme-dark .lex-d { color: #8fa0b8; }

/* ===== 守密人工具宫格（暗色） ===== */
.theme-dark .tool-card {
  background: #1a2233;
  border-color: #3a4a62;
}
.theme-dark .tool-card:active { background: #243044; }
.theme-dark .tool-card-name { color: #f4efe4; }

/* ===== 随机生成器按钮卡片（暗色） ===== */
.theme-dark .random-btn {
  background: #1a2233;
  border-color: #3a4a62;
}
.theme-dark .random-btn:active { background: #243044; }
.theme-dark .random-btn-name { color: #f4efe4; }

/* ===== NPC 卡片快捷统计 / 攻击（暗色） ===== */
.theme-dark .npc-card-stat-btn.plus { border-color: #d5a95c; color: #d5a95c; background: transparent; }
.theme-dark .npc-card-stat-btn.minus { border-color: #52627a; color: #aab6c8; background: transparent; }
.theme-dark .npc-card-stat-btn-active { background: #2f3b50; }
.theme-dark .npc-card-stat-val { color: #f4efe4; }
.theme-dark .npc-card-stat-label { color: #8fa0b8; }
.theme-dark .npc-card-attack { color: #d5a95c; }
.theme-dark .npc-attack-line {
  background: #1a2233;
  border-color: #3a4a62;
  color: #d5a95c;
}

/* ================================================================== */
/* ==================== 桌面端（大屏全屏）适配 ======================= */
/* 说明：rpx 会随窗口宽度等比放大，桌面布局统一使用 px 重新定义尺寸， */
/* 仅在 .layout-wide（JS 判定进入全屏布局）下生效，手机样式完全不受影响。 */
/* ================================================================== */

/* 手机状态栏预留已移到 .keeper-container 上（padding-top: 90rpx）。
   桌面端不再依赖媒体查询：
   - 全屏/宽屏：.layout-wide / .desk-fixed 覆盖 padding
   - 桌面窄条：容器内联 style 注入 deskTopInsetRpx（默认 0，可手动微调） */

.keeper-container.layout-wide {
  max-width: none;
  padding: 10px 14px 48px;
}

/* 宽屏任务/角色卡视图：直接钉在真实视口上（top/bottom 定位）。
   不使用 vh / windowHeight 计算高度——PC 端 vh 可能把窗口标题栏等装饰高度算进去，
   导致页面比可视区高一截、可滚动，内容被顶上移、底部露出空白。 */
.keeper-container.layout-wide.desk-fixed {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  padding: 10px 14px 14px;
  overflow-y: auto; /* 模块化工作台：整面滚动 */
}

/* ---- 任务列表（宽屏） ---- */
.layout-wide .keeper-header { padding: 24px 0 14px; }
.layout-wide .keeper-title { font-size: 24px; }
.layout-wide .keeper-subtitle { font-size: 13px; }
.layout-wide .section-title { font-size: 17px; }
.layout-wide .section-desc { font-size: 13px; }
.layout-wide .btn { padding: 13px 0; font-size: 15px; border-radius: 10px; max-width: 560px; margin-left: auto; margin-right: auto; }
.layout-wide .btn-import-task { padding: 13px 0; font-size: 14px; max-width: 560px; margin-left: auto; margin-right: auto; }
.layout-wide .task-list { max-width: 960px; margin: 16px auto 0; }
.layout-wide .task-item { padding: 13px 18px; margin-bottom: 8px; border-radius: 10px; }
.layout-wide .task-name { font-size: 15px; }
.layout-wide .task-meta { font-size: 12px; }
.layout-wide .task-copy { font-size: 12px; }
.layout-wide .task-delete { font-size: 18px; }
.layout-wide .task-search { max-width: 960px; margin: 16px auto 4px; }
.layout-wide .task-search-input { height: 38px; font-size: 13px; border-radius: 8px; }
.layout-wide .empty-hint { padding: 20px 0; font-size: 13px; }
.layout-wide .empty-state { padding: 26px 20px; border-radius: 12px; }
.layout-wide .empty-state-icon { font-size: 38px; }
.layout-wide .empty-state-title { font-size: 15px; }
.layout-wide .empty-state-desc { font-size: 12px; }
.layout-wide .back-btn { font-size: 14px; }

/* ---- 底部悬浮：布局模式切换栏 ---- */
.desk-modebar {
  position: fixed; right: 14px; bottom: 14px; z-index: 150;
  display: flex; align-items: center; gap: 4px;
  background: rgba(24, 28, 34, 0.88); border-radius: 999px;
  padding: 6px 10px; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
}
.desk-mode-hint { color: #cdd6e0; font-size: 12px; margin-right: 6px; }
.desk-mode-btn {
  color: #dbe3ec; font-size: 12px; padding: 4px 11px; border-radius: 999px;
  background: transparent;
}
.desk-mode-btn:active { background: rgba(255, 255, 255, 0.16); }
.desk-mode-btn.on { background: #d5a95c; color: #171207; font-weight: bold; }

/* ---- 模块化工作台骨架 ---- */
.desk-dash { display: flex; flex-direction: column; min-height: 100%; }
.desk-dash-detail { height: 100%; min-height: 0; }
.desk-topbar {
  position: sticky; top: 0; z-index: 8;
  display: flex; align-items: center; gap: 10px; flex-shrink: 0;
  padding: 8px 2px 10px; border-bottom: 2px solid #d4c5a9; margin-bottom: 12px;
  background: #f5f0e8;
}
.desk-task-name { font-size: 19px; font-weight: bold; color: #3b2e1e; }
.desk-task-meta { font-size: 12px; color: #8b7355; }
.desk-top-tip { font-size: 11px; color: #b3a58f; margin-left: auto; }
.desk-topbtns { margin-left: auto; display: flex; gap: 8px; }
.desk-topbtn {
  font-size: 13px; line-height: 1.4; padding: 6px 12px; margin: 0;
  border: 1px solid #d4c5a9; background: #faf8f4; border-radius: 8px; color: #5a3e22;
}
.desk-topbtn::after { border: none; }
.desk-topbtn:active { background: #f0e8d8; }

/* 瀑布流工作台：模块由 JS 引擎绝对定位，贴紧同列上一个模块 */
.desk-grid { position: relative; }
.desk-grid .desk-panel {
  position: absolute;
  top: 0; left: 0;
  opacity: 0;
  transition: opacity 0.15s ease, left 0.15s ease, top 0.15s ease;
}
.desk-grid.ready .desk-panel { opacity: 1; }

/* 宽屏卡片网格：按可用宽度自动排布，卡片宽度封顶避免被拉伸得太扁 */
.layout-wide .card-grid {
  grid-template-columns: repeat(auto-fill, minmax(196px, 300px));
  gap: 10px;
  justify-content: center;
}
.layout-wide .char-card { padding: 10px 12px; border-radius: 9px; }
.layout-wide .char-card-name { font-size: 14px; line-height: 1.35; }
.layout-wide .char-card-occ { font-size: 11px; margin-bottom: 5px; }
.layout-wide .char-card-visible { font-size: 14px; }
.layout-wide .char-card-edit { font-size: 15px; }
.layout-wide .char-card-delete { font-size: 16px; }
.layout-wide .wound-badge { font-size: 10px; padding: 1px 7px; border-radius: 6px; }
.layout-wide .npc-card-stats { gap: 10px; margin-top: 6px; }
.layout-wide .npc-card-stat { gap: 4px; }
.layout-wide .npc-card-stat-label { font-size: 11px; }
.layout-wide .npc-card-stat-btn {
  width: 25px; height: 25px; line-height: 21px; font-size: 15px; border-radius: 6px;
}
.layout-wide .npc-card-stat-val { font-size: 15px; min-width: 24px; }
.layout-wide .npc-card-attack { font-size: 12px; margin-top: 5px; }
.layout-wide .npc-card-attack-hint { font-size: 10px; padding: 1px 7px; border-radius: 8px; }

/* ---- 模块面板 ---- */
.desk-mod-actions { display: flex; gap: 4px; margin-left: auto; flex: none; }
.desk-mod-act {
  font-size: 12px; color: #5a3e22; background: #faf8f4;
  border: 1px solid #d4c5a9; border-radius: 6px; padding: 2px 8px;
}
.desk-mod-act:active { background: #f0e8d8; }
.desk-panel {
  flex: none; background: #ffffff;
  border: 1.5px solid #d4c5a9; border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  overflow: hidden; /* 面板内容绝不画到面板之外 */
}
.desk-panel.dragging {
  opacity: 0.9; z-index: 5;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  border-color: #6b4c2a;
  transition: none; /* 拖拽时禁用位置过渡，跟手 */
}
.desk-panel-head { display: flex; align-items: center; gap: 7px; padding: 8px 12px; }
.desk-panel-chevron { font-size: 12px; color: #8b7355; width: 14px; flex: none; }
.desk-panel-title { font-size: 14px; font-weight: bold; color: #3b2e1e; flex: 1; min-width: 0; }
.desk-panel-grip {
  margin-left: 0; color: #c4b8a8; font-size: 16px; line-height: 1;
  padding: 6px 4px; flex: none;
}
.desk-panel-grip:active { color: #6b4c2a; }
.desk-panel-body { padding: 0 12px 12px; }

/* ---- 面板内容尺寸（px 重定义） ---- */
.layout-wide .dice-rolling-hint { padding: 8px 0; font-size: 14px; }
.layout-wide .dice-result-highlight { margin-top: 4px; margin-bottom: 8px; padding: 12px; border-radius: 8px; }
.layout-wide .drh-total { font-size: 40px; }
.layout-wide .drh-dice { gap: 5px; margin-top: 6px; }
.layout-wide .drh-chip { padding: 3px 10px; border-radius: 12px; font-size: 11px; }
.layout-wide .drh-chip-line { font-size: 11px; }
.layout-wide .drh-chip-sub { font-size: 10px; }
.layout-wide .dice-row { gap: 6px; }
.layout-wide .dice-btn-wrap { width: calc(25% - 5px); }
.layout-wide .dice-btn { padding: 7px 0; font-size: 13px; border-radius: 6px; }
.layout-wide .dice-badge { min-width: 17px; height: 17px; line-height: 17px; font-size: 10px; top: -7px; right: -7px; }
.layout-wide .dice-actions { gap: 8px; margin-top: 8px; }
.layout-wide .btn-roll, .layout-wide .btn-clear-dice { padding: 8px 0; font-size: 13px; border-radius: 7px; }
.layout-wide .dice100-row { gap: 5px; margin-top: 7px; }
.layout-wide .dice100-label { font-size: 12px; }
.layout-wide .dice100-mode { padding: 4px 9px; font-size: 11px; border-radius: 6px; }
.layout-wide .dice-log { margin-top: 8px; padding-top: 6px; }
.layout-wide .dl-title { font-size: 12px; }
.layout-wide .dl-clear { font-size: 12px; }
.layout-wide .dl-item { font-size: 12px; padding: 3px 0; }
.layout-wide .dl-detail { font-size: 10px; }
.layout-wide .dl-time { font-size: 10px; }

.layout-wide .combat-toolbar { gap: 6px; margin-bottom: 6px; }
.layout-wide .combat-hint { font-size: 11px; margin-bottom: 6px; }
.layout-wide .combat-tie-warn { padding: 5px 10px; border-radius: 5px; margin-bottom: 6px; }
.layout-wide .combat-tie-warn text { font-size: 12px; }
.layout-wide .combat-tags { gap: 5px; }
.layout-wide .combat-tag { gap: 3px; padding: 4px 9px; border-radius: 6px; font-size: 12px; }
.layout-wide .combat-tag-idx { width: 15px; height: 15px; font-size: 10px; }
.layout-wide .combat-tag-dex { font-size: 10px; }

.layout-wide .madness-type-row { gap: 8px; margin-bottom: 10px; }
.layout-wide .madness-type-btn { padding: 8px 0; border-radius: 7px; font-size: 13px; }
.layout-wide .madness-roll-btn { margin-top: 6px; }
.layout-wide .madness-steps { margin-bottom: 10px; }
.layout-wide .mstep { gap: 8px; padding: 8px 10px; margin-bottom: 6px; border-radius: 7px; }
.layout-wide .mstep-num { width: 19px; height: 19px; font-size: 10px; }
.layout-wide .mstep-title { font-size: 13px; }
.layout-wide .mstep-result { font-size: 12px; }
.layout-wide .mstep-dice { font-size: 12px; min-width: 20px; border-radius: 4px; padding: 0 5px; margin: 0 3px; }
.layout-wide .madness-result { padding: 12px; border-radius: 9px; margin-bottom: 0; }
.layout-wide .madness-result-header { padding-bottom: 8px; margin-bottom: 10px; }
.layout-wide .madness-result-title { font-size: 14px; }
.layout-wide .madness-result-type { font-size: 10px; border-radius: 10px; padding: 2px 9px; }
.layout-wide .madness-result-parts { gap: 6px; }
.layout-wide .madness-result-part { padding: 7px 10px; border-radius: 6px; }
.layout-wide .madness-result-label { font-size: 11px; }
.layout-wide .madness-result-value { font-size: 13px; }

.layout-wide .random-btns { gap: 7px; }
.layout-wide .random-btn { width: calc(33.33% - 5px); padding: 10px 4px; border-radius: 8px; gap: 4px; }
.layout-wide .random-btn-icon { font-size: 20px; }
.layout-wide .random-btn-name { font-size: 12px; }
.layout-wide .random-result { padding: 10px 12px; margin-top: 8px; border-radius: 8px; }
.layout-wide .random-result-type { font-size: 11px; }
.layout-wide .random-result-value { font-size: 13px; }
.layout-wide .random-npc-data { margin-top: 6px; padding: 8px 10px; font-size: 12px; }
.layout-wide .random-npc-actions { gap: 6px; margin-top: 8px; }

.layout-wide .tpl-cats { gap: 6px; }
.layout-wide .tpl-cat { padding: 4px 11px; font-size: 12px; border-radius: 12px; }
/* 词汇列表：固定高度 + 内部滚动，避免内容溢出面板 */
.layout-wide .desk-lex-list {
  height: 240px;
  max-height: none;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.layout-wide .lex-item { padding: 7px 10px; margin-bottom: 6px; border-radius: 8px; }
.layout-wide .lex-w { font-size: 13px; }
.layout-wide .lex-d { font-size: 11px; }

.layout-wide .task-io-options { gap: 7px; }
.layout-wide .task-io-option { gap: 10px; padding: 9px 12px; border-radius: 8px; }
.layout-wide .task-io-icon { font-size: 20px; }
.layout-wide .task-io-title { font-size: 13px; }
.layout-wide .task-io-desc { font-size: 11px; }

/* ---- 对话框：宽屏下居中模态 ---- */
.layout-wide .dialog-sheet {
  top: 50%; left: 50%; right: auto; bottom: auto;
  width: 92vw; max-width: 660px; max-height: 86vh;
  border-radius: 14px;
  transform: translate(-50%, -50%) scale(0.96);
  opacity: 0; visibility: hidden; pointer-events: none;
  transition: transform 0.22s ease-out, opacity 0.22s ease-out, visibility 0.22s;
}
.layout-wide .dialog-sheet.active {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1; visibility: visible; pointer-events: auto;
}
.layout-wide .dialog-handle { display: none; }
.layout-wide .dialog-title { font-size: 17px; padding: 16px 24px 10px; }
.layout-wide .dialog-hint { font-size: 13px; }
.layout-wide .dialog-body-padded { padding: 0 24px 14px; }
.layout-wide .dialog-actions { padding: 12px 24px 16px; gap: 10px; }
.layout-wide .dialog-btn { font-size: 14px; padding: 11px 0; border-radius: 8px; }
.layout-wide .form-group { margin-bottom: 14px; }
.layout-wide .form-label { font-size: 14px; }
.layout-wide .form-input { height: 40px; font-size: 14px; padding: 0 12px; border-radius: 8px; }
.layout-wide .form-textarea { min-height: 120px; font-size: 13px; padding: 8px 12px; border-radius: 8px; }
.layout-wide .btn-subtle { font-size: 13px; padding: 7px 14px; border-radius: 7px; }
.layout-wide .btn-half { width: calc(50% - 6px); padding: 7px 0; font-size: 13px; }
.layout-wide .btn-third { width: calc(33.33% - 7px); padding: 7px 0; font-size: 12px; }

.layout-wide .npc-stat-bar { gap: 8px; margin-bottom: 10px; }
.layout-wide .npc-stat-item { padding: 8px 6px; border-radius: 7px; }
.layout-wide .npc-stat-label { font-size: 11px; }
.layout-wide .npc-stat-controls { gap: 5px; }
.layout-wide .npc-stat-btn { width: 25px; height: 25px; font-size: 14px; border-radius: 6px; }
.layout-wide .npc-stat-val { font-size: 17px; min-width: 28px; }
.layout-wide .npc-attack-line { font-size: 13px; padding: 7px 10px; margin-bottom: 8px; border-radius: 6px; }
.layout-wide .npc-text { min-height: 130px; }
.layout-wide .char-text-block { font-size: 13px; padding: 9px 12px; }

.layout-wide .check-info { padding: 11px 14px; border-radius: 9px; margin-bottom: 9px; }
.layout-wide .check-skill { font-size: 15px; }
.layout-wide .check-total { font-size: 11px; border-radius: 10px; padding: 2px 9px; }
.layout-wide .check-mode-row { gap: 6px; }
.layout-wide .check-result { margin-top: 10px; padding: 14px 12px; border-radius: 10px; }
.layout-wide .check-d100 { font-size: 46px; }
.layout-wide .check-level { font-size: 15px; padding: 4px 16px; border-radius: 12px; margin-top: 5px; }
.layout-wide .check-detail { font-size: 11px; }
.layout-wide .check-again { font-size: 13px; padding: 5px 14px; margin-top: 9px; border-radius: 8px; }
.layout-wide .check-damage { margin-top: 9px; }
.layout-wide .check-damage-btn { font-size: 14px; padding: 8px 22px; border-radius: 9px; }
.layout-wide .check-damage-result { margin-top: 8px; padding: 10px; border-radius: 8px; }
.layout-wide .cd-expr { font-size: 12px; }
.layout-wide .cd-total { font-size: 28px; }
.layout-wide .cd-parts { font-size: 11px; }

.layout-wide .tpl-list { height: 42vh; }
.layout-wide .tpl-item { gap: 10px; padding: 8px 10px; margin-bottom: 8px; border-radius: 8px; }
.layout-wide .tpl-icon { font-size: 22px; }
.layout-wide .tpl-name { font-size: 14px; }
.layout-wide .tpl-stats { font-size: 11px; }
.layout-wide .tpl-desc { font-size: 12px; }
.layout-wide .tpl-add { font-size: 22px; }
.layout-wide .io-sample-title { font-size: 13px; margin: 12px 0 6px; }
.layout-wide .io-sample { font-size: 12px; padding: 9px 12px; border-radius: 8px; }

/* ---- 角色卡详情：左侧列表 + 右侧卡片 ---- */
.desk-dash-detail .desk-player { flex: 1; display: flex; gap: 12px; min-height: 0; overflow: hidden; }
.desk-player-list {
  width: 240px; flex: none; height: 100%; box-sizing: border-box;
  background: #ffffff;
  border: 1.5px solid #d4c5a9; border-radius: 10px;
}
.desk-player-item { padding: 9px 14px; border-bottom: 1px solid #f0e8d8; }
.desk-player-item:active { background: #f0e8d8; }
.desk-player-item.on { background: #fdf5e6; border-left: 3px solid #6b4c2a; }
.desk-player-name { font-size: 14px; font-weight: bold; color: #3b2e1e; display: block; }
.desk-player-hp { font-size: 11px; color: #8b7355; display: block; margin-top: 2px; }
.desk-player-sheet {
  flex: 1; min-width: 0; height: 100%; box-sizing: border-box;
  background: #ffffff;
  border: 1.5px solid #d4c5a9; border-radius: 10px;
}
.desk-sheet { border: none; border-radius: 0; box-shadow: none; padding: 20px 28px 40px; }
.layout-wide .char-name { font-size: 21px; }
.layout-wide .char-sub { font-size: 13px; }
.layout-wide .char-section-title { font-size: 14px; margin: 14px 0 8px; }
.layout-wide .char-attr-row { grid-template-columns: repeat(4, 1fr); gap: 6px; }
.layout-wide .char-attr { padding: 6px 10px; font-size: 13px; border-radius: 6px; }
.layout-wide .char-deriv-row { gap: 8px; }
.layout-wide .char-deriv { min-width: 90px; padding: 8px; border-radius: 6px; }
.layout-wide .char-deriv-label { font-size: 11px; }
.layout-wide .char-deriv-value { font-size: 16px; }
.layout-wide .skill-cat-title { font-size: 13px; padding: 8px 0 5px 6px; }
.layout-wide .skill-grid { grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 6px 0; }
.layout-wide .skill-grid-item { padding: 7px 10px; border-radius: 7px; }
.layout-wide .skill-grid.review .skill-grid-item { padding: 6px 10px; }
.layout-wide .skill-grid-name { font-size: 13px; }
.layout-wide .skill-grid-val { font-size: 14px; }
.layout-wide .weapon-row { padding: 6px 10px; }
.layout-wide .weapon-header .weapon-cell { font-size: 11px; }
.layout-wide .weapon-cell { font-size: 12px; }
.layout-wide .weapon-empty-text { font-size: 12px; }

/* ==================== 桌面端暗色主题 ==================== */
.theme-dark .desk-topbar { border-color: #3a4a62; background: #111827; }
.theme-dark .desk-task-name { color: #f4efe4; }
.theme-dark .desk-task-meta { color: #8fa0b8; }
.theme-dark .desk-top-tip { color: #768398; }
.theme-dark .desk-topbtn { background: #1a2233; border-color: #3a4a62; color: #d5a95c; }
.theme-dark .desk-topbtn:active { background: #243044; }
.theme-dark .desk-mod-act { background: #1a2233; border-color: #3a4a62; color: #d5a95c; }
.theme-dark .desk-mod-act:active { background: #243044; }
.theme-dark .desk-panel,
.theme-dark .desk-player-list,
.theme-dark .desk-player-sheet { background: #1d2636; border-color: #3a4a62; }
.theme-dark .desk-panel.dragging { border-color: #d5a95c; }
.theme-dark .desk-panel-title { color: #f4efe4; }
.theme-dark .desk-panel-chevron { color: #8fa0b8; }
.theme-dark .desk-panel-grip { color: #768398; }
.theme-dark .desk-panel-grip:active { color: #d5a95c; }
.theme-dark .desk-player-item { border-bottom-color: #2f3b50; }
.theme-dark .desk-player-item:active { background: #243044; }
.theme-dark .desk-player-item.on { background: #243044; border-left-color: #d5a95c; }
.theme-dark .desk-player-name { color: #f4efe4; }
.theme-dark .desk-player-hp { color: #8fa0b8; }
.theme-dark .desk-sheet { background: transparent; }

/* ================================================================== */
/* ============== 线索表 / 团务笔记 / 规则速查 / 战斗轮增强 ============ */
/* ================================================================== */

/* ---- 线索表 ---- */
.clue-add-row { display: flex; gap: 12rpx; margin-bottom: 14rpx; align-items: center; }
.clue-add-row .clue-input { height: 68rpx; font-size: 24rpx; flex: 1; min-width: 0; }
.clue-item {
  background: #faf8f4; border: 1.5px solid #e8e0d6; border-radius: 10rpx;
  padding: 12rpx 16rpx; margin-bottom: 10rpx;
}
.clue-item.given { opacity: 0.55; }
.clue-text { font-size: 26rpx; color: #3b2e1e; display: block; line-height: 1.5; }
.clue-source { font-size: 20rpx; color: #8b7355; display: block; margin-top: 4rpx; }
.clue-actions { display: flex; justify-content: flex-end; align-items: center; gap: 16rpx; margin-top: 6rpx; }
.clue-given { font-size: 22rpx; color: #16a085; font-weight: bold; padding: 4rpx 10rpx; }
.clue-given.off { color: #8b7355; font-weight: normal; }

/* ---- 团务笔记 ---- */
.note-item {
  background: #faf8f4; border: 1.5px solid #e8e0d6; border-radius: 10rpx;
  padding: 12rpx 16rpx; margin-bottom: 10rpx;
}
.note-item:active { background: #f0e8d8; }
.note-title { font-size: 26rpx; font-weight: bold; color: #3b2e1e; display: block; }
.note-preview {
  font-size: 22rpx; color: #7a6b58; display: block; margin-top: 4rpx;
  line-height: 1.5; max-height: 96rpx; overflow: hidden;
}
.note-actions { margin-top: 6rpx; }

/* ---- 规则速查 ---- */
.rules-list { margin-top: 12rpx; }
.rule-item {
  background: #faf8f4; border: 1.5px solid #e8e0d6; border-radius: 10rpx;
  padding: 12rpx 16rpx; margin-bottom: 10rpx;
}
.rule-w { font-size: 26rpx; font-weight: bold; color: #3b2e1e; display: block; }
.rule-d { font-size: 22rpx; color: #7a6b58; line-height: 1.6; display: block; margin-top: 4rpx; }

/* ---- 战斗轮增强 ---- */
.combat-round-row {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 24rpx; color: #6b4c2a; font-weight: bold; margin-bottom: 10rpx;
}
.combat-current-row {
  display: flex; justify-content: space-between; align-items: center;
  background: #fdfaf4; border: 1.5px solid #d4c5a9; border-radius: 8rpx;
  padding: 8rpx 14rpx; margin-bottom: 10rpx;
}
.cc-name { font-size: 24rpx; font-weight: bold; color: #3b2e1e; }
.cc-hp { color: #8b7355; font-weight: normal; font-size: 22rpx; }
.cc-btns { display: flex; gap: 10rpx; }
.cc-btn {
  font-size: 22rpx; font-weight: bold; padding: 4rpx 16rpx; border-radius: 8rpx;
  border: 1.5px solid #d4c5a9; color: #5a3e22; background: #fff;
}
.cc-btn:active { background: #f0e8d8; }
.cc-btn.plus { border-color: #6b4c2a; color: #6b4c2a; background: #fdfaf4; }
.cc-btn.minus { border-color: #c4b8a8; color: #8b7355; }
.combat-dmg-row { display: flex; gap: 10rpx; align-items: center; margin-bottom: 10rpx; }
.combat-dmg-input {
  flex: 1.4; min-width: 0; height: 64rpx; font-size: 22rpx;
  border: 1.5px solid #d4c5a9; border-radius: 8rpx; padding: 0 14rpx;
  background: #faf8f4; color: #3b2e1e; box-sizing: border-box;
}
.combat-tag-hp { font-size: 18rpx; opacity: 0.75; font-weight: normal; flex: none; }

/* ---- 宽屏 px 重定义 ---- */
.layout-wide .clue-add-row { gap: 6px; margin-bottom: 8px; }
.layout-wide .clue-add-row .clue-input { height: 30px; font-size: 12px; }
.layout-wide .clue-item { padding: 7px 10px; margin-bottom: 6px; border-radius: 8px; }
.layout-wide .clue-text { font-size: 13px; }
.layout-wide .clue-source { font-size: 11px; }
.layout-wide .clue-actions { gap: 10px; margin-top: 4px; }
.layout-wide .clue-given { font-size: 12px; padding: 2px 8px; }
.layout-wide .note-item { padding: 7px 10px; margin-bottom: 6px; border-radius: 8px; }
.layout-wide .note-title { font-size: 13px; }
.layout-wide .note-preview { font-size: 11px; max-height: 44px; }
.layout-wide .rule-item { padding: 7px 10px; margin-bottom: 6px; border-radius: 8px; }
.layout-wide .rule-w { font-size: 13px; }
.layout-wide .rule-d { font-size: 11px; }
.layout-wide .combat-round-row { font-size: 12px; margin-bottom: 6px; }
.layout-wide .combat-current-row { padding: 6px 10px; margin-bottom: 6px; border-radius: 6px; }
.layout-wide .cc-name { font-size: 13px; }
.layout-wide .cc-hp { font-size: 12px; }
.layout-wide .cc-btn { font-size: 12px; padding: 3px 10px; border-radius: 6px; }
.layout-wide .combat-dmg-row { gap: 6px; margin-bottom: 6px; }
.layout-wide .combat-dmg-input { height: 30px; font-size: 12px; padding: 0 8px; }
.layout-wide .combat-tag-hp { font-size: 10px; }

/* ---- 暗色 ---- */
.theme-dark .clue-item,
.theme-dark .note-item,
.theme-dark .rule-item { background: #1a2233; border-color: #2f3b50; }
.theme-dark .note-item:active { background: #243044; }
.theme-dark .clue-text,
.theme-dark .note-title,
.theme-dark .rule-w { color: #f4efe4; }
.theme-dark .clue-source,
.theme-dark .note-preview,
.theme-dark .rule-d { color: #8fa0b8; }
.theme-dark .clue-given { color: #7fd8b7; }
.theme-dark .clue-given.off { color: #8fa0b8; }
.theme-dark .combat-round-row { color: #d5a95c; }
.theme-dark .combat-current-row { background: #1a2233; border-color: #3a4a62; }
.theme-dark .cc-name { color: #f4efe4; }
.theme-dark .cc-hp { color: #8fa0b8; }
.theme-dark .cc-btn { background: #1a2233; border-color: #3a4a62; color: #d5a95c; }
.theme-dark .cc-btn:active { background: #243044; }
.theme-dark .cc-btn.plus { border-color: #d5a95c; color: #d5a95c; background: #1a2233; }
.theme-dark .cc-btn.minus { border-color: #52627a; color: #aab6c8; }
.theme-dark .combat-dmg-input { background: #1a2233; border-color: #3a4a62; color: #e6edf7; }

/* ================================================================== */
/* ==================== 规则速查紧凑表格 / AI 备团 ==================== */
/* ================================================================== */

/* ---- 规则速查：紧凑双列表格 ---- */
.rule-table {
  background: #faf8f4; border: 1.5px solid #e8e0d6; border-radius: 10rpx;
  padding: 2rpx 8rpx; margin: 12rpx 0;
  display: grid; grid-template-columns: 1fr 1fr;
}
.rule-cell {
  display: flex; justify-content: space-between; align-items: center; gap: 10rpx;
  padding: 8rpx 10rpx; border-bottom: 1px solid #eee8dd; min-width: 0;
}
.rule-cell-name { font-size: 22rpx; color: #3b2e1e; font-weight: bold; flex-shrink: 0; }
.rule-cell-val { font-size: 22rpx; color: #6b4c2a; font-weight: bold; text-align: right; }

/* ---- AI 备团 ---- */
.ai-copy-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.ai-import-row { display: flex; flex-wrap: wrap; gap: 8rpx; }
.ai-paste { min-height: 160rpx; width: 100%; }

/* ---- 宽屏 px 重定义 ---- */
.layout-wide .rule-table { border-radius: 8px; padding: 1px 6px; margin: 8px 0; }
.layout-wide .rule-cell { gap: 6px; padding: 4px 8px; }
.layout-wide .rule-cell-name { font-size: 12px; }
.layout-wide .rule-cell-val { font-size: 12px; }
.layout-wide .ai-copy-row { gap: 6px; margin-bottom: 8px; }
.layout-wide .ai-import-row { gap: 6px; }
.layout-wide .ai-paste { min-height: 90px; }

/* ---- 暗色 ---- */
.theme-dark .rule-table { background: #1a2233; border-color: #2f3b50; }
.theme-dark .rule-cell { border-bottom-color: #2f3b50; }
.theme-dark .rule-cell-name { color: #f4efe4; }
.theme-dark .rule-cell-val { color: #d5a95c; }

/* ================================================================== */
/* ==================== 线索表：搜索 / 标签筛选 ======================= */
/* ================================================================== */
.clue-search-row { margin-bottom: 10rpx; }
.clue-search-input {
  width: 100%; height: 64rpx; box-sizing: border-box;
  background: #faf8f4; border: 1.5px solid #d4c5a9; border-radius: 8rpx;
  padding: 0 14rpx; font-size: 24rpx; color: #3b2e1e;
}
.clue-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.clue-loc-row { margin-top: 4rpx; }
.clue-item-loc {
  display: inline-block; font-size: 20rpx; color: #6b4c2a;
  background: #f0e8d8; border-radius: 8rpx; padding: 2rpx 10rpx;
}
.clue-addloc { font-size: 20rpx; color: #b3a58f; padding: 4rpx 6rpx; }

.layout-wide .clue-search-row { margin-bottom: 8px; }
.layout-wide .clue-search-input { height: 30px; font-size: 12px; padding: 0 8px; border-radius: 6px; }
.layout-wide .clue-tags { gap: 6px; margin-bottom: 8px; }
.layout-wide .clue-item-loc { font-size: 11px; padding: 1px 7px; border-radius: 6px; }
.layout-wide .clue-addloc { font-size: 11px; }
/* 大屏模块最大高度：线索量大，限制放宽到 480px，列表内部滚动 */
.layout-wide .clue-list { max-height: 480px; overflow-y: auto; padding-right: 2px; }

.theme-dark .clue-search-input { background: #1a2233; border-color: #3a4a62; color: #e6edf7; }
.theme-dark .clue-item-loc { background: #243044; color: #d5a95c; }
.theme-dark .clue-addloc { color: #768398; }
