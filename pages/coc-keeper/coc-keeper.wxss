.npc-card { background: #fdf9f0; border: 2px solid #e0c9a8; }
.char-card.low { border-color: #e67e22; }
.char-card.dead { border-color: #c0392b; background: #fdf3f1; }
.npc-card.dead { border-color: #c0392b; background: #fdf3f1; }
.wound-badge {
  display: inline-block; font-size: 18rpx; color: #fff; background: #e67e22;
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 8rpx;
}

/* ===== 数值变化动效 ===== */
.npc-card-stat-val.flash { animation: statFlash 0.5s ease; }
@keyframes statFlash {
  0% { transform: scale(1.6); color: #e67e22; }
  100% { transform: scale(1); }
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  background: #faf8f4; border: 2px dashed #d4c5a9; border-radius: 16rpx;
  padding: 48rpx 32rpx; margin-top: 16rpx;
}
.empty-state-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.empty-state-title { font-size: 28rpx; font-weight: bold; color: #3b2e1e; margin-bottom: 8rpx; }
.empty-state-desc { font-size: 22rpx; color: #8b7355; text-align: center; line-height: 1.6; }

/* ===== 以上（暗色） ===== */
.theme-dark .player-card { background: #16283d; border-color: #31548c; }
.theme-dark .npc-card { background: #2a2018; border-color: #7d6a4a; }
.theme-dark .char-card.low { border-color: #e67e22; }
.theme-dark .char-card.dead,
.theme-dark .npc-card.dead { border-color: #c0392b; background: #2a1818; }
.theme-dark .wound-badge { background: #e67e22; color: #111827; }
.theme-dark .empty-state { background: #1a2233; border-color: #3a4a62; }
.theme-dark .empty-state-title { color: #f4efe4; }
.theme-dark .empty-state-desc { color: #8fa0b8; }

/* ===== 词汇表（暗色） ===== */
.theme-dark .lex-item {
  background: #1a2233;
  border-color: #2f3b50;
}
.theme-dark .lex-item:active { background: #243044; }
.theme-dark .lex-w { color: #f4efe4; }
.theme-dark .lex-d { color: #8fa0b8; }

/* ===== 守密人工具宫格（暗色） ===== */
.theme-dark .tool-card {
  background: #1a2233;
  border-color: #3a4a62;
}
.theme-dark .tool-card:active { background: #243044; }
.theme-dark .tool-card-name { color: #f4efe4; }

/* ===== 随机生成器按钮卡片（暗色） ===== */
.theme-dark .random-btn {
  background: #1a2233;
  border-color: #3a4a62;
}
.theme-dark .random-btn:active { background: #243044; }
.theme-dark .random-btn-name { color: #f4efe4; }

/* ===== NPC 卡片快捷统计 / 攻击（暗色） ===== */
.theme-dark .npc-card-stat-btn.plus { border-color: #d5a95c; color: #d5a95c; background: transparent; }
.theme-dark .npc-card-stat-btn.minus { border-color: #52627a; color: #aab6c8; background: transparent; }
.theme-dark .npc-card-stat-btn-active { background: #2f3b50; }
.theme-dark .npc-card-stat-val { color: #f4efe4; }
.theme-dark .npc-card-stat-label { color: #8fa0b8; }
.theme-dark .npc-card-attack { color: #d5a95c; }
.theme-dark .npc-attack-line {
  background: #1a2233;
  border-color: #3a4a62;
  color: #d5a95c;
}
